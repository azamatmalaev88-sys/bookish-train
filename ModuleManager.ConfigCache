			#Kopernicus_UI_MissingTextures_Title = Kopernicus - Fehlende Texturen
			#Kopernicus_UI_MissingTextures_Description = Einige Planeten-Texturen konnten nicht geladen werden. Oft liegt dies an fehlerhaften Konfigurationsdateien eines Planetenpakets, es kann aber auch auf eine fehlerhafte Installation zurückzuführen sein. Die unten aufgeführten Planeten werden wahrscheinlich in irgendeiner Weise fehlerhaft sein. Je nach den betroffenen Texturen kann es sich um geringfügige Probleme handeln oder die Planeten könnten völlig unbrauchbar sein. Das Laden vorhandener Spielstände erfolgt auf eigene Gefahr.
			#Kopernicus_UI_MissingTextures_NoBody = <no body>
			#Kopernicus_UI_MissingTextures_Close = Schließen
		}
	}
}
