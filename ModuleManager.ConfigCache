			VARIANT
			{
				name = Dark
				displayName = Темный
				themeName = Dark
				primaryColor = #4c4f47
				secondaryColor = #4c4f47
				GAMEOBJECTS
				{
					125mConeBlackWhite = false
					125mConeWhite = false
					125mConeDark = true
					125mConeOrange = false
				}
			}
			VARIANT
			{
				name = White
				displayName = Белый
				themeName = White
				primaryColor = #ffffff
				secondaryColor = #ffffff
				GAMEOBJECTS
				{
					125mConeBlackWhite = false
					125mConeWhite = true
					125mConeDark = false
					125mConeOrange = false
				}
			}
			VARIANT
			{
				name = Orange
				displayName = Серый и оранжевый
				themeName = Orange
				primaryColor = #4c4f47
				secondaryColor = #f49841
				GAMEOBJECTS
				{
					125mConeBlackWhite = false
					125mConeWhite = false
					125mConeDark = false
					125mConeOrange = true
				}
			}
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Parts/Aero/airbrake/Airbrake.cfg
	PART
	{
		name = airbrake1
		module = Part
		author = Porkjet
		mesh = Airbrake.mu
		rescaleFactor = 1
		node_attach = 0.0, 0.0, -0.025, 0.0, 0.0, 1.0, 1
		TechRequired = advAerodynamics
		entryCost = 20000
		cost = 1000
		category = Aero
		subcategory = 0
		title = А.Э.Р.О.Т.О.Р.М.О.З.
		manufacturer = Завод «C7 Космотех»
		description = Исследования возможных способов замедления самолёта в воздухе показали, что оттопырившиеся куски фюзеляжа прекрасно работают в качестве устройства замедления, работающего по принципу повышения аэродинамического сопротивления. Это открытие легло в основу изобретения Аэродинамического Экранирующего Реактивного Обтекаемого Тормозного Ограничителя Расстояния Максимального Остаточного Замедления (А.Э.Р.О.Т.О.Р.М.О.З.), который приобрёл популярность в качестве недорогой альтернативы длинным взлётно-посадочным полосам. Инженеры C7 до сих пор не придумали ёмкое и лаконичное название для него.
		attachRules = 0,1,0,0,1
		mass = 0.05
		thermalMassModifier = 5.0
		emissiveConstant = 0.4
		dragModelType = none
		maximum_drag = 0.02
		minimum_drag = 0.02
		angularDrag = 2
		crashTolerance = 8
		maxTemp = 2400
		explosionPotential = 0.1
		fuelCrossFeed = True
		bulkheadProfiles = srf
		tags = (air airbrake aircraft brake dive drag fligh landing plane slow speed spoil (возд аэротормоз самолёт тормоз нырок сопротивление полёт приземление плоскость замедление скорость посадка
		MODULE
		{
			name = ModuleAeroSurface
			useInternalDragModel = True
			dragCoeff = 0.6
			deflectionLiftCoeff = 0.38
			ctrlSurfaceRange = 70
			ctrlRangeFactor = 0.2
			ctrlSurfaceArea = 1
			actuatorSpeed = 20
			transformName = Flap
			defaultActionGroup = Brakes
			liftingSurfaceCurve = SpeedBrake
			ignorePitch = true
