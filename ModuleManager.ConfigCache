			#autoLOC_8400536 = Поместите 2 узла «Диалоговое окно» рядом с 2 узлами «Совершивший посадку аппарат».
			#autoLOC_8400537 = Соедините один узел диалогового окна с узлом аппарата, совершившего посадку на Кербине, а второй — с узлом аппарата, совершившего посадку на Муне.
			#autoLOC_8400538 = Соедините узлы диалогового окна с узлами «Совершивший посадку аппарат».
			#autoLOC_8400539 = В каждом узле диалогового окна напишите подходящий текст. Игрок увидит его, если успешно завершит миссию, так что не скупитесь на похвалы!
			#autoLOC_8400540 = Напишите игроку хвалебное сообщение.
			#autoLOC_8400541 = Выберите название корабля в выпадающем списке.
			#autoLOC_8400542 = Свяжем узел «Аппарат потерпел крушение» с аппаратом игрока. Выберите этот узел, затем найдите название созданного вами аппарата в выпадающем списке подзаголовка «Аппарат потерпел крушение».
			#autoLOC_8400543 = Напишите подходящее сообщение, которое увидят на экране игроки, умудрившиеся уничтожить свой аппарат.
			#autoLOC_8400544 = Щёлкните по соответствующему полю узла «Диалоговое окно» и напишите там подходящее сообщение.
			#autoLOC_8400545 = Вы, наверное, заметили, что некоторые узлы подсвечены красным, а в верхней части макета отображается красная кнопка. Таким образом игра сигнализирует об ошибке в миссии.
			#autoLOC_8400546 = Игра уведомит вас обо всех найденных ошибках. Миссии, в которых есть ошибки, можно сохранять, но нельзя экспортировать.
			#autoLOC_8400547 = Чтобы посмотреть на обнаруженные ошибки, щёлкните по красной кнопке в верхней части макета.
			#autoLOC_8400548 = Щёлкните по красной кнопке в верхней части макета.
			#autoLOC_8400549 = Это отчёт об ошибках в миссии. Как видите, сейчас в миссии нет ни одного конечного узла. Обозначим узлы диалоговых окон конечными узлами, чтобы исправить ошибку.
			#autoLOC_8400550 = Закройте сообщение, щёлкните по каждому из 3 узлов «Диалоговое окно» и выберите параметр «Назначить конечным узлом».
			#autoLOC_8400551 = В настройках укажите, что узлы «Диалоговое окно» — конечные.
			#autoLOC_8400552 = Осталось экспортировать миссию. Все данные будут собраны в один файл, чтобы вы могли поделиться своей миссией со всем миром!
			#autoLOC_8400553 = Щёлкните по подсвеченной кнопке «Предполётный инструктаж», чтобы открыть сообщение инструктажа перед миссией.
			#autoLOC_8400554 = Щёлкните по подсвеченной кнопке, чтобы открыть сообщение предполётного инструктажа.
			#autoLOC_8400555 = Здесь отображается текст предполётного инструктажа, задачи, а также баллы и награды, доступные в этой миссии.
			#autoLOC_8400556 = Вы можете также указать сведения о модах, которые нужны для выполнения вашей миссии; добавить миссию в набор; обозначить сложность миссии, чтобы игроки знали, что их ждёт!
			#autoLOC_8400557 = Наконец, вы можете добавить баннеры, которые будут отображаться при просмотре предполётного инструктажа, а также в случае успешного выполнения или провала миссии.
			#autoLOC_8400558 = Отличный отчет! Теперь вы можете либо продолжить миссию и приземлиться на Муне, либо лететь домой. Выбор за вами!
			#autoLOC_8400559 = Пропавшее описание из руководства для опытных игроков.
			#autoLOC_9990010 = Руководство для знающих основы
			#autoLOC_9990011 = Добро пожаловать! Пришло время закрепить пройденное и приступить к более сложному материалу!
			#autoLOC_9990012 = Для разнообразия рассмотрим ситуацию, когда игрок уже приземлился в определённое место на Муне.\n\nВыберите узел «Совершивший посадку аппарат» и биом из выпадающего списка «Тип локации».
			#autoLOC_9990013 = Выберите биом из выпадающего списка «Тип локации».
			#autoLOC_9990014 = Для выбора биома воспользуемся графической панелью в нижней части панели действия.\n\nУправление точно такое же, как в Центре слежения. Приближать и отдалять камеру можно с помощью колеса мыши. Чтобы выбрать планету, щёлкайте левой кнопкой мыши по стрелкам, расположенным по обе стороны от названия планеты.\n\nДля перемещения вокруг планет зажмите левую кнопку мыши и двигайте мышью.
			#autoLOC_9990015 = Обратите внимание: подходящие биомы подсвечиваются при наведении на них курсора.\n\nВыберите какой-нибудь биом, щёлкнув по нему.
			#autoLOC_9990016 = Выберите биом на Муне с помощью панели действия.
			#autoLOC_9990017 = Хорошо. Теперь добавим событие.\n\nСобытия — это ситуации, которые влияют на ход миссии. Игрок ничего не знает заранее — он узнаёт о событиях только в момент активации соответствующих узлов, поэтому с их помощью можно создавать непредсказуемые ситуации и даже катастрофические происшествия!
			#autoLOC_9990018 = Мы начнём с чего-нибудь попроще, но в дальнейшем вы сможете наполнить свои миссии множеством событий, катастрофических или же, напротив, благоприятных.
			#autoLOC_9990019 = Найдите узел науки и поместите его между узлом орбиты Муны и узлом «Совершивший посадку аппарат».
			#autoLOC_9990020 = Перетащите на макет узел события «Научный эксперимент» (категория «Ресурсы и наука»).
			#autoLOC_9990021 = Теперь соединим узел события с узлом орбиты и узлом посадки.\n\nНо сначала необходимо удалить уже существующую соединительную линию: щёлкните по линии и нажмите кнопку Delete.
			#autoLOC_9990022 = Соедините узел события с узлом орбиты и узлом посадки.
			#autoLOC_9990023 = Если к узлу с несколькими исходящими соединениями присоединить узел события, то узел события всегда будет срабатывать первым.
			#autoLOC_9990024 = Перейдите в настройки узла науки и поставьте галочку напротив узла события.
			#autoLOC_9990025 = Чтобы продолжить, поставьте галочку напротив узла события.
			#autoLOC_9990026 = Давайте сообщим игроку, что перед возвращением домой кербонавтам необходимо исследовать странные показатели, зафиксированные на высокой орбите Муны.
			#autoLOC_9990027 = Перетащите на макет узел «Диалоговое окно» и поместите его между узлами орбиты и науки — так же, как вы присоединили узел науки. Теперь при достижении узла орбиты игрок увидит сообщение.\n\nНе забудьте удалить существующую соединяющую линию!
			#autoLOC_9990028 = Соедините узел «Диалоговое окно» с узлами орбиты и науки.
			#autoLOC_9990029 = Щёлкните по узлу диалогового окна и в настройках напишите: «Мы зафиксировали какие-то странные показатели на высокой орбите Муны. Увеличьте орбиту и посмотрите, как поведёт себя таинственная слизь!»
			#autoLOC_9990030 = Напишите сообщение, адресованное игроку.
			#autoLOC_9990031 = Продолжим. Пришло время задать настройки узла события.
			#autoLOC_9990032 = В списке экспериментов узла события выберите вариант «Наблюдение за слизью». В условиях выберите «Высокий полёт», а в планетах — «Муна». Остальные настройки оставьте без изменений.
			#autoLOC_9990033 = Выберите эксперимент «Наблюдение за слизью». В условиях выберите «Высокий полёт», а в небесных телах — «Муна».
			#autoLOC_9990034 = Теперь предложим игроку несколько вариантов развития событий: возможность выбора даст ему некоторую свободу.
			#autoLOC_9990035 = Сообщим игроку, что после наблюдения за слизью он может либо отправляться на родную планету, либо совершить посадку на Муну.
			#autoLOC_9990036 = Перетащите на макет ещё один узел «Диалоговое окно». Поместите его после узла «Научный эксперимент» и присоедините его к узлу «Совершивший посадку аппарат».\n\nНе забудьте удалить лишние соединяющие линии.
			#autoLOC_9990037 = Соедините узел «Диалоговое окно» с узлом науки и узлом «Совершивший посадку аппарат».
			#autoLOC_9990038 = Теперь напишите сообщение, что игрок может либо отправиться домой, либо совершить посадку на Муну.\n\nНедостающий узел мы добавим чуть позже.
			#autoLOC_9990039 = Напишите сообщение, адресованное игроку.
			#autoLOC_9990040 = Отлично! Перетащите ещё один узел «Совершивший посадку аппарат» из категории «Локация» и соедините его с последним размещённым узлом «Диалоговое окно».
			#autoLOC_9990041 = Перетащите на макет узел «Совершивший посадку аппарат» и свяжите его с узлом «Диалоговое окно».
			#autoLOC_9990042 = Здорово! Теперь выберите Кербин из списка планет.
			#autoLOC_9990043 = Выберите Кербин в настройках узла.
			#autoLOC_9990044 = Вы также можете добавить в миссию систему оценки, чтобы игроки видели, насколько успешно они справляются с вашей миссией по сравнению с другими игроками.
			#autoLOC_9990045 = Давайте укажем, что игроки получат дополнительные очки, если выполнят научный эксперимент за отведённое время!
			#autoLOC_9990046 = Перетащите на макет узел «Время от» из категории «Функциональность» и расположите его под узлом «Научный эксперимент».
			#autoLOC_9990047 = Перетащите на макет узел «Время от» из категории «Функциональность».
			#autoLOC_9990048 = Дадим игроку 1 день на выполнение эксперимента — этого времени хватит с головой, чтобы скорректировать орбиту.
			#autoLOC_9990049 = Щёлкните по узлу «Время от узла» и выберите «Научный эксперимент» из выпадающего меню. Затем в качестве оператора сравнения выберите «Меньше» и установите время на 1 день в поле «День».
			#autoLOC_9990050 = Из выпадающего меню выберите «Научный эксперимент», в качестве оператора сравнения выберите «Меньше» и установите время на 1 день.
			#autoLOC_9990051 = Великолепно! Теперь найдите узел «Изменить счёт» в категории «Кредиты и очки» и поместите его рядом с узлом «Время от».
			#autoLOC_9990052 = Перетащите на макет узел «Изменить счёт» из категории «Кредиты и очки».
			#autoLOC_9990053 = Щёлкните по узлу «Изменить счёт». В поле рядом с параметром «Доп. очки» укажите, сколько очков получит игрок, если проведёт научный эксперимент менее чем за 1 день игрового времени.
			#autoLOC_9990054 = Введите в поле рядом с параметром «Доп. очки» любое число.
			#autoLOC_9990055 = Последний штрих: соединим всё необходимое.
			#autoLOC_9990056 = Проведите линию от узла науки к узлу «Время от».\n\nЗатем от узла «Время от» проведите линию к узлу «Изменить счёт».\n\nИ наконец, от узла «Изменить счёт» проведите линию к узлу «Диалоговое окно», чтобы связать всё воедино.
			#autoLOC_9990057 = Соедините узел науки с узлом «Время от узла». Затем узел «Время от узла» с узлом «Изменить счёт». И наконец, узел «Изменить счёт» с узлом «Текст диалога».
			#autoLOC_9990058 = Сегодня вы узнали, как события могут влиять на ход миссии. Впереди вас ждёт ещё одно руководство. Завершив обучение, вы сможете создавать собственные миссии и творить свою историю.\n\nНе забывайте почаще сохраняться!
		}
	}
}
