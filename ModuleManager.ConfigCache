			#autoLOC_8006163 = Разбить «Муну-2»
			#autoLOC_8006164 = Провал миссии
			#autoLOC_8006165 = Да, мы говорили о крушении, но зачем это было делать здесь и сейчас?
			#autoLOC_8006166 = Ожидание крушения «Муны-1»
