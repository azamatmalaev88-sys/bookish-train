UrlConfig
{
	parentUrl = Squad/Resources/CometDefs.cfg
	COMET_ORBIT_TYPE
	{
		name = short
		displayName = Малый период
		description = Кометы — это шары, состоящие из разного рода замороженных летучих веществ, камня и пыли.\n\nВ результате взаимодействия с другими космическими телами данная комета перешла на более низкую орбиту. Учитывая скорость таяния её ледяной составляющей, ей осталось недолго — по крайней мере по астрономическим меркам. Наслаждайтесь световым шоу, пока это возможно.
		inclination1Min = -15
		inclination1Max = 15
		inclination2Min = 165
		inclination2MAx = 180
		inclination1Chance = 0.8
		peMin = 0.1
		peMax = 0.31
		apMin = 0.83
		apMax = 1.25
		minCometClass = E
		maxCometClass = F
		chanceWeight = 50
	}
}
UrlConfig
{
	parentUrl = Squad/Resources/CometDefs.cfg
	COMET_ORBIT_TYPE
	{
		name = intermediate
		displayName = Средний период
		description = Кометы — это шары, состоящие из разного рода замороженных летучих веществ, камня и пыли.\n\nНебольшой процент комет входит по внутреннюю систему с апоцентром возле Джула, что обусловлено огромной гравитацией зелёного гиганта. С учётом того, как часто кометы приближаются к солнцу, их не так уж и мало. Это одна из таких комет. Период обращения позволяет довольно часто наблюдать её.
		inclination1Min = -40
		inclination1Max = 40
		inclination2Min = 40
		inclination2MAx = 180
		inclination1Chance = 0.8
		peMin = 0.068
		peMax = 0.31
		apMin = 1.25
		apMax = 3.12
		minCometClass = F
		maxCometClass = H
		chanceWeight = 40
	}
}
UrlConfig
{
	parentUrl = Squad/Resources/CometDefs.cfg
	COMET_ORBIT_TYPE
	{
		name = long
		displayName = Длительный период
		description = Кометы — это шары, состоящие из разного рода замороженных летучих веществ, камня и пыли.\n\nСчитается, что многие кометы рождаются в облаке объектов, обращающемся вдали от зафиксированных планетарных объектов. Первый этап на пути превращения в комету — выход на высокую эллиптическую орбиту, входящую во внутреннюю систему неподалёку от некоего объекта.
		inclination1Min = -40
		inclination1Max = 40
		inclination2Min = 40
		inclination2MAx = 180
		inclination1Chance = 0.8
		peMin = 0.1
		peMax = 0.31
		apMin = 4.16
		apMax = 21
		minCometClass = G
		maxCometClass = H
		chanceWeight = 9
	}
}
UrlConfig
{
	parentUrl = Squad/Resources/CometDefs.cfg
	COMET_ORBIT_TYPE
	{
		name = interstellar
		displayName = Межзвёздный
		description = Кометы — это шары, состоящие из разного рода замороженных летучих веществ, камня и пыли.\n\nЭта комета находится на гиперболической орбите относительно солнца, что делает её одним из редчайших объектов в системе, подлинным межзвёздным странником, в своих одиноких путешествиях лишь единожды посетившим нас.
		inclination1Min = -180
		inclination1Max = 180
		inclination1Chance = 1
		peMin = 0.2
		peMax = 0.31
		useEccentricity = true
		eccentricityMin = 1.01
		eccentricityMax = 1.4
		minCometClass = G
		maxCometClass = I
		chanceWeight = 1
	}
}
