		fx_gasBurst_white = 0.0, 1.354437, 0.8369194, 0.0, 0.0, 1.0, activate
		sound_decoupler_fire = activate
		TechRequired = generalConstruction
		entryCost = 1800
		cost = 200
		category = Structural
		subcategory = 0
		title = Пусковая мачта TT18-A
		manufacturer = Бомб Демонтаж Корп.
		description = Пусковая мачта TT18-A использует новаторскую технологию крепления и значительно увеличивает устойчивость корабля на этапе предстартовой подготовки. Несмотря на критику «Бомб Демонтаж» за «пристрастие к длинным и сложным словам в названиях», никто не может оспорить, что TT18-A обеспечивает незыблемую фиксацию на старте, как гласит реклама. Руководство пользователя настоятельно рекомендует помещать эти устройства в самой нижней части ракеты-носителя и активировать сразу после вывода двигателей на взлётный режим.
		attachRules = 0,1,0,1,0
		mass = 0.1
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.2
		angularDrag = 2
		crashTolerance = 100
		maxTemp = 2000
		fuelCrossFeed = False
		explosionPotential = 0.1
		breakingForce = 150
		breakingTorque = 150
		stageOffset = 0
		childStageOffset = 0
		preferredStage = LAST
		bulkheadProfiles = srf
		tags = clam hold )pad rocket stabil tower захват опора стол ракета стабилизация мачта
