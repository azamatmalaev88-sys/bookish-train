			#autoLOC_501783 = отделять
			#autoLOC_501784 = Отделитель TD-12
			#autoLOC_501785 = Отделитель TD-12 снабжён небольшим (к счастью) пирозарядом, способным разорвать крепление между ним и присоединённой к одной из его сторон деталью. Нарисованные по бокам стрелки указывают, какая сторона будет отделена.
			#autoLOC_501786 = отделять
