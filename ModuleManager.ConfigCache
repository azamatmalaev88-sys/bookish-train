UrlConfig
{
	parentUrl = Shabby/shabby-version.cfg
	KERBALCHANGELOG
	{
		modName = Shabby
		VERSION
		{
			version = 0.4.2
			versionDate = 2025-05-26
			change = Fix loading of custom icon shaders with KSPCF v1.37+ installed
		}
		VERSION
		{
			version = 0.4.1
			versionDate = 2025-04-04
			change = Gracefully handle failing to patch a Shader.Find callsite (usually in generic methods).  Specifically this would occur with KRPC and cause any further patches to be skipped.
			change = Change several spammy log messages to be debug-only
			change = Skip applying material replacements to renderers that don't have a sharedMaterial (some ParticleSystemRenderers apparently)
		}
		VERSION
		{
			version = 0.4.0
			versionDate = 2024-09-09
			change = Major build system refactor, and adoption by the KSPModdingLibs team.
			CHANGE
			{
				type = Added
				change = Added material-replacement functionality using the `SHABBY_MATERIAL_DEF` node
			}
		}
		VERSION
		{
			version = 0.3.0
			versionDate = 2022-08-03
			change = Add the rest of the main harmony distro
		}
		VERSION
		{
			version = 0.2.0
			versionDate = 2021-03-18
			change = Migrate to Harmony 2.0
		}
		VERSION
		{
			version = 0.1.2
			versionDate = 2020-06-15
			change = Make the zip have GameData as the root, As requested by @drewcassidy (CineboxAndrew).
		}
		VERSION
		{
			version = 0.1.1
			versionDate = 2020-06-13
			CHANGE
			{
				type = Removed
				change = Remove KSP version specification. Either it works or it doesn't.
			}
		}
		VERSION
		{
			version = 0.1.0
			versionDate = 2020-06-13
			CHANGE
			{
				type = Changed
				change = Make the logging a little less noisy
				subchange = Shows only custom shaders being found and a (hopefully) successful hook.
			}
		}
		VERSION
		{
			version = 0.0.0
			versionDate = 2020-05-09
			change = initial commit
			change = Shaders are loaded from asset bundles with a ".shab" extension.
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = C7 Aerospace Division
		title = Завод «C7 Космотех»
		description = Незачем лететь вверх, если разбиться можно и летя в другую сторону — таков давний девиз компании «C7 Космотех». Она начала с маленькой кустарной мастерской и выросла в огромную корпорацию, но всегда неудержимо стремилась за горизонт. В последнее время компания сосредоточилась на выпуске компонентов, которые помогают лучше разглядеть, где небеса встречаются с землей. Разумеется, старожилы предприятия не в восторге от последних разработок «C7 Космотех», но тоже признают, что приключения на свою голову можно найти везде.
		logoURL = Squad/Agencies/C7AerospaceDivision
		logoScaledURL = Squad/Agencies/C7AerospaceDivision_scaled
		mentality = Pioneer
		mentality = Commercial
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Dinkelstein Kerman's Construction Emporium
		title = Конструкторская фирма «Керман и сыновья»
		description = Динкельштейн Керман является вроде как легендой космической индустрии. Не в последнюю очередь это связано с его решительными заявлениями о том, что он конструировал ракеты и осуществлял космические полёты задолго до того, как первый подобный агрегат вообще был официально собран. Это стало причиной определённого недопонимания и целого ряда неловких ситуаций между ним и Всемирным Сообществом Регистрации Рекордов Кербина. Как бы то ни было, конструкторская фирма «Керман и сыновья» до сих пор на хорошем счету как верная традициям, несколько старомодная фирма, из продуктов которой песка сыпется намного меньше, чем из её владельца.
		logoURL = Squad/Agencies/DinkelsteinKermansConstructionEmporium
		logoScaledURL = Squad/Agencies/DinkelsteinKermansConstructionEmporium_scaled
		mentality = Commercial
		mentality = Economic 0.3
		mentality = EasyGoing 0.25
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Experimental Engineering Group
		title = НПО «Эксперимент»
		description = НПО «Эксперимент» представляет собой типичный образчик начинающей компании: минимальный бюджет и совершенно невыполнимые сроки для них в порядке вещей. Несмотря на столь юный возраст, эта компания неплохо стартовала в индустрии и достаточно быстро заработала себе имя, во многом благодаря учебно-развлекательному лабораторному комплексу SC-9001, познавательную и развлекательную ценность которого по достоинству оценили многие фанаты космоса. Несмотря на героические усилия своих представителей, компании все жё не удалось избежать скандала в прессе. Причиной шумихи стала утечка фотографий, на которых видно, что один из научных сотрудников НПО «Эксперимент» использовал производимый компанией модуль в качестве домика для своего любимого хомячка. Говорят, после этого инцидента компания всерьёз озаботилась вопросами безопасности всего, что находится поблизости от её продукции. Более того, им пришлось даже закруглить края логотипа.
		logoURL = Squad/Agencies/ExperimentalEngineering
		logoScaledURL = Squad/Agencies/ExperimentalEngineering_scaled
		mentality = Commercial
		mentality = Conglomerate 0.1
		mentality = Ecomental
		mentality = Kerbalminded
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = FLOOYD Dynamics Research Labs
		title = Научная лаборатория НИТРО2
		description = Научная лаборатория НИТРО2 посвятила всю свою деятельность тому, что умеет делать лучше всего: перемещению жидкостей из одной ёмкости в другую. Флагманом линейки лаборатории является топливопровод FTX-2, ставший венцом многолетней научно-исследовательской программы, в ходе которой несчетное количество кербало-часов было потрачено на разработку устройства, позволяющего перекачивать любые объёмы любых субстанций, независимо от их температуры, плотности или летучести. Благодаря столь значительному вкладу в развитие отрасли компания завоевала отменную репутацию на рынке, что позволило позабыть о катастрофическом провале топливопровода серии FTX-1. Тогда это привело к отзыву практически всех произведенных изделий из-за небольшой, но весьма досаждающей проблемы: жидкости перекачивались безупречно, но, к огромному сожалению, совершенно не в том направлении.
		logoURL = Squad/Agencies/FlooydResearchLab
		logoScaledURL = Squad/Agencies/FlooydResearchLab_scaled
		mentality = Commercial
		mentality = Ecomental
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Goliath National Products
		title = Федеральная корпорация «Голиаф»
		description = В федеральной корпорации «Голиаф» прекрасно знают, как быть на шаг впереди конкурентов: всё дело во внимании к деталям и умении предвосхищать потребности дотошных инженеров. Множество прекрасных Аппаратов нашего времени оснащены носовыми обтекателями от «Голиафа», которые неумолимо рассекают воздух и прокладывают путь для самых важных деталей наших кораблей — то есть для наших бравых искателей приключений.
