		MODULE
		{
			name = ModuleScienceExperiment
			experimentID = surfaceSample
			experimentActionName = Взять образец грунта
			resetActionName = Отклонить образец
			reviewActionName = Просмотреть образец
			hideUIwhenUnavailable = True
