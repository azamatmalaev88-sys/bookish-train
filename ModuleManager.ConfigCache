UrlConfig
{
	parentUrl = Firefly/FireflyChangelog.cfg
	KERBALCHANGELOG
	{
		modName = Firefly
		VERSION
		{
			version = 1.0.6
			versionDate = 2026-03-26
			change = Fix window duplication bug (thanks **@infradmin**)
			change = Fix settings loading (thanks **@Rodg88**, **@cordilon**)
			change = Fix startup NRE
		}
		VERSION
		{
			version = 1.0.5
			versionDate = 2025-07-03
			change = Fix black trail bug
			change = Bring back missing bowshock
			change = Separate FireflyAPI into separate mod
			change = Introduce install checker for FireflyAPI
		}
		VERSION
		{
			version = 1.0.4
			versionDate = 2025-07-02
			change = Create FireflyAPI, which allows modders to use the effect override system
			change = Introduce config versioning
			change = Add Space Shuttle System envelope (thanks **@giuliodondi**)
			change = Make the effect override system more universal, which should allow mods to create custom effects using Firefly
			change = Fix the particles (again), now they should be done for good
			change = Fix Gigantor XL solar panels having bugged effects
			change = Fix Communotron 16 having bugged effects
		}
		VERSION
		{
			version = 1.0.3
			versionDate = 2025-04-10
			change = Add particle config
			change = Add particle editor
			change = Add Ervo config for MPE (thanks **@SPACEMAN9813**)
			change = Remove individual particle toggles from settings (replaced by particle editor)
			change = Improve smoke trail particles
		}
		VERSION
		{
			version = 1.0.2
			versionDate = 2025-03-01
			change = Add configs for Kcalbeloh and OPM (thanks **@SPACEMAN9813**)
			change = Add Sol compatibility
			change = Add temporary workaround for drill envelope
			change = Make the smoke particles much faster and longer
			change = Make the dynamic pressure affect the effect strength more, fixing the RSS transition (again)
			change = Fix particle systems going in wrong direction in certain cases
		}
		VERSION
		{
			version = 1.0.1
			versionDate = 2025-02-17
			change = #### WARNING FOR PLANET PACK MAKERS:
			change = This update makes some changes to the **planet pack** configs. Please make sure you update them.
			change = Add custom envelopes for benjee10's SOCK
			change = Add error/problem handling and list, warning users about incorrect installs or other issues
			change = Add warning about enabled stock effects
			change = Add additional message to the effect editor, informing to not use the simulation sliders in normal gameplay
			change = Add `transition_offset` to the planet pack configs
			change = Change planet pack config `speed_multiplier` to `strength_multiplier`
			change = Fix RSS reentry starting too late
			change = Fix graphics bug on Linux + Proton (Mac is still broken though), huge thanks to **@bmsbwd, @KlyithSA and @Cypherthe1st** for helping to find the fix
		}
		VERSION
		{
			version = 1.0.0.0
			versionDate = 2025-02-05
			change = Initial Release
		}
	}
}
