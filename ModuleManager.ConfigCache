		mentality = Economic 0.3
		mentality = Moral 0.4
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Rokea Inc
		title = Корпорация «Rokea»
		description = Компания «Rokea» известна, в основном, своими «улучшителями вертикальной мобильности», которые ни в коем случае нельзя путать с обычными «трапами» или «лестницами». Несмотря на скептическое отношение общественности к этому пунктику компании, представители «Rokea» неустанно ведут разъяснительную работу по фундаментальным различиям между примитивными «лестницами» и высокотехнологичными решениями для «улучшения вертикальной мобильности». Вероятно, причиной такой информационной стратегии стало то, что всем на это просто плевать.
