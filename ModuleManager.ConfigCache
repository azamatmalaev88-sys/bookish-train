UrlConfig
{
	parentUrl = Squad/Parts/Utility/commDish88-88/commDish88-88.cfg
	PART
	{
		name = commDish
		module = Part
		author = Andrew Cassidy
		scale = 1
		rescaleFactor = 1
		node_stack_bottom = 0.0, -0.13, 0.0, 0.0, -1.0, 0.0, 0
		node_attach = 0.0, -0.13, 0.0, 0.0, -1.0, 0.0, 0
		TechRequired = automation
		entryCost = 20000
		cost = 1500
		category = Communication
		subcategory = 0
		title = Коммунотрон 88-88
		manufacturer = Ионик Синхрофазотроника
		description = Направленная антенна «Коммунотрон 88-88» обеспечивает намного более надёжную связь на огромных расстояниях, чем предыдущие модели, отчасти благодаря запатентованной складной параболической конструкции. Наша исследовательская группа отрицает любые обвинения в том, что идею они позаимствовали у обычного зонтика.
		attachRules = 1,1,0,0,0
		mass = 0.1
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.2
		angularDrag = 2
		crashTolerance = 7
		maxTemp = 2000
		PhysicsSignificance = 1
		bulkheadProfiles = size0, srf
		tags = aerial antenna deploy direct dish extend fold radio signal transmi воздушная антенна развертывание прямой тарелка расширение складной радио сигнал передача
		MODULE
		{
			name = ModuleDeployableAntenna
			showStatus = false
			isTracking = false
			pivotName = Dish
			windResistance = 1
			animationName = Deploy
			extendActionName = Раскрыть <<akk,c:1>>
			retractActionName = Убрать <<akk,c:1>>
			extendpanelsActionName = Перекл. <<akk,c:1>>
			destroyOnBreakObject = Sphere001
		}
		MODULE
		{
			name = ModuleDataTransmitter
			antennaType = DIRECT
			packetInterval = 0.10
			packetSize = 2
			packetResourceCost = 20.0
			requiredResource = ElectricCharge
			DeployFxModules = 0
			antennaPower = 100000000000
			antennaCombinable = True
		}
		MODULE
		{
			name = ModuleCargoPart
			packedVolume = 60
		}
		MODEL
		{
			model = ReStock/Assets/Communication/restock-antenna-stack-4
		}
		MODULE
		{
			name = ModuleRestockDepthMask
			maskTransform = DepthMask
		}
	}
}
