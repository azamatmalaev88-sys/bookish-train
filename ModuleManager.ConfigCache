		node_stack_interstage06a = 0.0, 3.20, 0.0, 0.0, -1.0, 0.0, 0
		node_stack_interstage06b = 0.0, 3.24, 0.0, 0.0, 1.0, 0.0, 0
		node_stack_top = 0.0, 0.22, 0.0, 0.0, 1.0, 0.0, 0
		node_stack_bottom = 0.0, -0.2, 0.0, 0.0, -1.0, 0.0, 1
		fx_gasBurst_white = 0.0, 0.3, 0.0, 0.0, 1.0, 0.0, deploy
		sound_vent_large = deploy
		TechRequired = advConstruction
		entryCost = 3000
		cost = 300
		category = Payload
		subcategory = 0
		title = Защитный обтекатель AE-FF1 (1,25 м)
		manufacturer = Научная лаборатория НИТРО2
		description = Пока в Центре управления полётами придумывали способы возвращения корабля с орбиты в целости и сохранности, инженеры-исследователи НИТРО2 вовремя осознали, что защита деталей во время взлёта не менее важна. В надежде создать эффективный защитный обтекатель для полезной нагрузки и межступенчатых элементов было профинансировано сложнейшее исследование двухмерного процедурного строительства. Мы также надеемся, что улучшение аэродинамики позволит сэкономить немного драгоценного топлива!
		attachRules = 1,0,1,1,0
		mass = 0.075
		thermalMassModifier = 2.0
		skinMassPerArea = 4.0
		skinInternalConductionMult = 0.25
		emissiveConstant = 0.8
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.2
		angularDrag = 2
		crashTolerance = 9
		maxTemp = 2600
		fuelCrossFeed = True
		stageOffset = 1
		childStageOffset = 1
		inverseStageCarryover = false
		bulkheadProfiles = size1
		tags = аэро )обтекатель перетащить ракета конус нос груз содержать обтекатель пустой интер грузоподъёмность защищать покрытие ступень (хран транспорт 3,75 массивный громадный гигантский 5,0
		MODEL
		{
			model = Squad/Parts/Aero/fairings/AutoTruss
			scale = 1,1,1
			position = 0.0,0.22,0.0
		}
		MODULE
		{
			name = ModuleProceduralFairing
			nSides = 30
			nArcs = 2
			nCollidersPerXSection = 6
