UrlConfig
{
	parentUrl = Squad/Parts/Engine/Size3EngineCluster/part.cfg
	PART
	{
		name = Size3EngineCluster
		module = Part
		author = Chris Adderley (Nertea)
		scale = 1.0
		node_stack_top = 0.0,1.527248,0.0 , 0.0, 1.0, 0.0, 3
		mass = 15
		heatConductivity = 0.06
		skinInternalConductionMult = 4.0
		emissiveConstant = 0.8
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.2
		angularDrag = 2
		breakingForce = 400
		breakingTorque = 400
		crashTolerance = 20
		maxTemp = 2000
		TechRequired = veryHeavyRocketry
		entryCost = 115000
		cost = 39000
		category = Engine
		subcategory = 0
		title = ЖРД KS-25x4 «Мамонт»
		manufacturer = Корпорация «Кербодайн»
		description = Инженерам «Кербодайн» надоело возиться со сложнейшими многоступенчатыми конструкциями для вывода на орбиту большой полезной нагрузки, и они решили вместо этого построить по-настоящему огромный двигатель. Вместо одной огромной камеры сгорания (которые по-прежнему взрываются при повышении давления) было решено использовать четыре небольших камеры с собственными соплами. Соединив четыре двигателя KS-25 в один блок, инженеры создали самый большой ракетный двигатель из когда-либо производившихся. Разумеется, его мощность соответствует размеру, но, хотя он и превосходен в своей основной роли двигателя первой ступени, отсутствие нижнего крепёжного узла делает его малопригодным для любых других задач. Его цена, кстати, тоже вполне соответствует размеру.
		attachRules = 1,0,1,1,0
