UrlConfig
{
	parentUrl = Squad/Strategies/Departments.cfg
	STRATEGY_DEPARTMENT
	{
		name = Finances
		title = Кредиты
		desc = Он — бухгалтер. Его имя — Мортимер. У него мало друзей. Зато он любит, чтобы всё было по местам и под контролем. У него очень сложная и напряжённая работа.
		color = 254 250 135
		avatar = Strategy_Mortimer
		headName = Мортимер Керман
		headImage = MORTIMER_KERMAN
	}
}
UrlConfig
{
	parentUrl = Squad/Strategies/Departments.cfg
	STRATEGY_DEPARTMENT
	{
		name = Science
		title = Наука
		desc = Линус — аспирант Вернера фон Кермана. Сам Вернер — слишком важная персона, чтобы тратить своё время на эти скучные стратегические совещания. Поэтому вместо себя он посылает своего представителя.
		color = 135 253 254
		avatar = Strategy_ScienceGuy
		headName = Линус Керман
		headImage = SCIGUY_KERMAN
	}
}
UrlConfig
{
	parentUrl = Squad/Strategies/Departments.cfg
	STRATEGY_DEPARTMENT
	{
		name = Public Relations
		title = Связи с общественностью
		desc = Вольт Керман — официальный пресс-секретарь космической программы и менеджер по связям с общественностью. Он носит костюм химзащиты, совершенно не обязательный при его должности, но весьма полезный для того, кому приходится работать в настолько вредном окружении.
		color = 149 254 135
		avatar = Strategy_PRGuy
		headName = Вольт Керман
		headImage = PRGUY_KERMAN
	}
}
UrlConfig
{
	parentUrl = Squad/Strategies/Departments.cfg
	STRATEGY_DEPARTMENT
	{
		name = Operations
		title = Эксплуатация
		desc = Гас Керман занимает должность руководителя эксплуатационного отдела космической программы. Он и есть тот вездесущий парень, который чинит всё, что ломается. Именно благодаря ему во всех наших кабинах есть иллюминаторы.
		color = 254 178 0
		avatar = Strategy_MechanicGuy
		headName = Гас Керман
		headImage = PRGUY_KERMAN
	}
}
