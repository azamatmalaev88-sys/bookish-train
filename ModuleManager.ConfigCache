UrlConfig
{
	parentUrl = Squad/Resources/ScienceDefs.cfg
	EXPERIMENT_DEFINITION
	{
		id = evaScience
		title = Научный эксперимент в открытом космосе
		baseValue = 25
		scienceCap = 25
		dataScale = 1
		requireAtmosphere = False
		requireNoAtmosphere = False
		situationMask = 63
		biomeMask = 0
		RESULTS
		{
			default = По результатам наблюдений за астронавтами, взявшими в руки наборы для проведения научных экспериментов в открытом космосе, стало ясно, что это не поспособствовало развитию у них творческого мышления.
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Resources/StoryDefs.cfg
	STORY_DEF
	{
		Introduction
		{
			Generic = Как следствие, мягко говоря, катастрофического происшествия в компании [Agency], мы вынуждены искать помощи извне.
			Generic = Работая поздно вечером, учёные агентства [Agency] получили некоторую информацию чрезвычайной важности.
			Generic = Убирая последствия случайного возгорания, один из уработавшихся учёных с бейджем [Agency] на груди задался интересным вопросом.
			Generic = [Agency] в лице своего совета директоров поднимает ряд серьёзных проблем.
			Generic = [Agency], а если быть точнее — главный исполнительный директор (и по совместительству главный мойщик бутылок) — сообщает о проблеме.
			Generic = [Agency] далеко не в первый (и уж точно не в последний) раз сталкивается с незапланированными возгораниями и взрывами, в связи с чем задаётся определёнными вопросами.
			Generic = [Agency] не боится пробовать новое. В результате, мы частенько оказываемся в ситуации, когда нам требуется помощь со стороны.
			ARM = [Agency] обладает впечатляющей коллекцией камней.
			Base = [Agency] считает делом чести обеспечить благополучную доставку кербалов в самые отдалённые уголки вселенной.
			CollectScience = [Agency] может похвастать лучшими научными умами, ну а наша с вами задача — загрузить работой их мозги.
			CollectScience = Научно-исследовательское подразделение компании [Agency] вплотную подошло к разгадке единой теории гравиоли.
			Exploration = В воплощении в жизнь своей мечты [Agency] полагается на самых храбрых кербалов и передовые технологии.
			Exploration = [Agency] неукоснительно следует своему главному принципу — неустанно раздвигать границы науки.
			CometSample = Ученые из агентства [Agency] жаждут изучить комету вблизи. Попробуем исполнить их желание.
			CometSample = Агентство [Agency] всегда было заинтересовано в могучих хвостатых чужаках, врывающихся в нашу Солнечную систему, — то есть в кометах.
			CometSample = Агентство [Agency] сделало немало удивительных вещей, но если нам удастся устроить рандеву с кометой, скорее всего, это войдёт в историю как наше самое блестящее достижение.
			PartTest = [Agency] находится в щекотливом положении. Проблему обнаружил один из наших инженеров, обстукивавший детали гаечным ключом.
			PartTest = [Agency] сообщает об ошибке, обнаруженной в нашем каталоге продукции.
			PlantFlag = [Agency] гордится своим флагом и хочет сделать с ним что-нибудь особенное.
			PlantFlag = [Agency] декларирует строгую приверженность корпоративным ценностям и ищет способы заявить о своём бренде в поистине космических масштабах.
			RecoverAsset = [Agency] славится своей приверженностью кербалеческим ценностям. Именно поэтому мы умеем признавать свои ошибки. Это как раз тот случай.
			RecoverAsset = [Agency] нельзя упрекнуть в невнимательности к деталям, но на этот раз мы, кажется, упустили что-то действительно серьёзное.
			Satellite = [Agency] постоянно ищет способы максимально продуктивно использовать имеющиеся в распоряжении спутники.
			Satellite = [Agency] сообщает о небольшом избытке деталей на складах, что даёт нам возможность построить пару новых орбитальных спутников.
			Station = [Agency] предлагает весьма интересные проекты по строительству станций, которые вполне согласуются с нашим представлением о полезном использовании космического пространства.
			Survey = [Agency] активно изучает карты в поисках интересных местечек и, кажется, всё-таки нашлось что-то стоящее.
			Survey = Мы с коллегами из [Agency] использовали при выборе следующего шага мишень для дартса. Вам выпало кое-что интересное.
			Tourism = [Agency] неустанно ищет новые источники дохода. Наши бухгалтеры говорят о беспрецедентном росте индустрии космического туризма. Мы не должны упускать такой шанс.
			CometDetection = Сотни лет кометы были излюбленным объектом изучения, а агентство [Agency] никак нельзя обвинить в том, что оно не следует моде!
			CometDetection = Исследование комет позволяет сделать выводы о составе других солнечных систем. Учёные агентства [Agency] стремятся собрать как можно больше данных об этих космических снежках.
			CometDetection = Различные типы комет могут дать уникальную информацию о возникновении Солнечной системы, а также о динамике поведения солнечного ветра. К тому же находка кометы — отличный пиар. [Agency] хочет получить и то, и другое.
			CometDetection = Как говорят, кометы — это шарики льда, присыпанные пылью. Фигурально выражаясь, мороженое с шоколадной крошкой. Соблазнительно звучит, верно? Некоторым учёным такое сравнение не по вкусу, но к нам в агентстве [Agency] это не относится.
			RoverConstruction = Недавно мы запустили планетоход, призванный помочь [Agency] в исследовании солнечной системы.
			RoverConstruction = В прошлом году [Agency] удалось посадить планетоход на далёкое космическое тело.
			VesselRepair = У одного из наших орбитальных спутников случилась серьёзная поломка.
			VesselRepair = У нашего спутника связи случилась небольшая поломка. Сложно сказать, кто виноват.
			VesselRepair = Несмотря на все усилия специалистов [Agency], в нашем дорогостоящем космическом оборудовании случилась серьёзная поломка.
			OrbitConstruction = Некоторое время назад [Agency] вывело на орбиту этой планеты спутник с целью… впрочем, вам не положено это знать.
			OrbitConstruction = Какое-то время назад [Agency] запустило в космос очень дорогой спутник.
		}
		Problem
		{
			Generic = Возможно, мы недооценили степень взрывоопасности твёрдого ракетного топлива. Однако масштаб возникшей из-за этого проблемы осознаём более чем полно.
			Generic = Для проверки новых предположений научных теорий нам нужно больше мусорных объектов на низкой орбите.
			Generic = Мы не знаем, может ли болтов быть слишком много, но непременно должны это выяснить.
			Generic = Мы пытаемся выяснить, имеет ли вся материя во вселенной такую же плотность, как и на Кербине, но пока ещё не решили как это можно узнать.
			Generic = Мы хотим узнать, какие оттенки зелёного может увидеть кербал при высоких перегрузках.
			ARM = Стандартная модель дает весьма оптимистичный прогноз числа астероидов. По факту [Topic] со своей орбитой этим похвастаться не может.
			ARM = [Topic] со своей орбитой является настоящим кладезем астероидов. А одна каменюка у нас под боком стоит двух таких же, затерявшихся в космосе. Мы это докажем!
			Base = В рамках проекта «[Topic] и с чем <<O:2>> едят» мы хотели бы провести ряд экспериментов, исследующих возможность долгосрочного пребывания кербалов за пределами Кербина.
			CollectScience = Но для этого нам нужен кто-то, кто воплотит нашу научную методику... в космосе!
			CollectScience = Нам нужны кое-какие научные данные. Желательно, конечно, получить что-то новое, но в целом нам подойдёт абсолютно любая информация.
			CollectScience = Нам нужно заполнить кое-какие научные формы, и мы полагаем, что для этого лучше использовать какие-нибудь данные, полученные из космоса.
			CollectScience = Наши научные контейнеры пусты, а отправляться в другой биом для их пополнения желающих нет.
			Exploration = В списке непобитых нами рекордов по-прежнему есть пункты, и мы хотели бы как можно скорее вычеркнуть их оттуда.
			CometSample = Вот почему нам нужно отправить кербала к объекту «[Topic]» и получить образец вещества кометы. Кербал должен быть чрезвычайно отважным. Позаботьтесь о том, чтобы он прихватил с собой салфетки для шлема: они пригодятся, если комета окажется рядом с солнцем.
			CometSample = Вам понадобится отважный астронавт для посещения объекта «[Topic]». Ему нужно будет добыть что-то вроде снежного комка, вроде тех, что вылетают из-под колёс зимой — только этот комок намного, намного ценнее с точки зрения науки.
			CometSample = Условия на поверхности кометы могут быть довольно суровыми. Надеемся, у вас есть на примете кербал, достаточно глу... отважный, чтобы посетить объект «[Topic]» и отщипнуть от него кусочек для научного анализа.
			Launch = Никто ещё не устанавливал космических рекордов! Возможно, для начала нужно доставить что-нибудь на стартовую площадку. После этого мы можем начинать беспокоиться о вещах наподобие выживаемости.
			Orbit = Проблема в том, что мы не имеем понятия, насколько сложно вывести кербала на орбиту, и должны срочно узнать это.
			GrandTour = Мы хотим узнать, на сколько планет можно отправить кербонавта, прежде чем он перестанет нас слушаться и от скуки по дому вернётся на корабле обратно.
			GrandTour = Мы пытаемся заполнить межпланетную цветовую палитру и ищем кого-нибудь, кто поможет нам проверить парочку новых небесных тел.
			GrandTour = Мы не утверждаем, что на других планетах нашей солнечной системы существует жизнь, но... Пришельцы — это же так интересно!
			ISRU = Интересно, добыть <<akk:2>> где-то за пределами Кербина — это так же легко, как отнять конфетку у кербалёнка?
			ISRU = Мы уверены, что <<akk:2>> можно встретить ещё во многих уголках солнечной системы. И мы это докажем!
			PartTest = Практически ничего неизвестно о том, как [Topic] вёдет себя в условиях, которые невозможно получить в лаборатории.
			PartTest = В этом руководстве чётко заявляется: [Topic] является лидером в своем классе. Чтобы избежать всяких юридических проблем, нам нужно чем-то подтвердить свои претензии.
			PartTest = На наших складах валяется слишком много деталей, похожих на [Topic], и никто точно не знает, как они работают.
			PartTest = Мы не можем точно сказать, как [Topic] крепится к другим деталям. Снизу? Сверху? Можно ли вообще сказать, с какой стороны это делается?
			PlantFlag = Если [Topic] будет нести на себе наш флаг, то мы сможем с гордостью утверждать, что находимся впереди наших конкурентов.
			PlantFlag = [Topic] обладает твёрдой поверхностью. Так это или нет, лучше всего проверить, водрузив там флаг.
			PlantFlag = <<dat:2>> станет только лучше, если водрузить на <<2[нём/ней/нём]>> ещё один флаг. Но самим нам туда не добраться.
			RecoverAsset = Очевидно, проверять теорию об опасности космического мусора с помощью обитаемого корабля было не самой лучшей идеей. Если [Topic] с вашей помощью благополучно вернётся домой, мы постараемся больше никогда никого там не бросать.
			RecoverKerbal = Мы потеряли кербала! Без вас [Topic] вряд ли когда-нибудь найдется! Мы опасаемся, что <<O:2>> запасы сухпайка уже подходят к концу.
			RecoverKerbal = Мы проводим множество экспериментов, связанных с длительным пребыванием кербалов в космосе. Всё шло хорошо, пока одним прекрасным утром [Topic] с какого-то перепугу не <<2[вышел/вышла]>> за пределы своей капсулы.
			RecoverKerbal = Нам поступила информация, что [Topic] испытывает проблемы с реактивным ранцем. Всё очень серьёзно! Кажется, остальные члены экипажа попросту забыли дождаться возвращения своего товарища и оставили <<O:2>> на орбите.
			RecoverPart = Хорошенько поиграв с программой «Механический Билл», наш инженерный отдел нашёл новый метод расчёта характеристической скорости аппарата без кербала на борту. Однако, увлёкшись процессом, мы и не подумали, что [Topic] надо как-то вернуть домой по окончании всех процедур.
			RecoverPart = Используя нашу новую программу «Инженер Джеба», мы активно экспериментовали с методами расчета параметров орбиты аппарата без кербала на борту. По окончании экспериментов мы столкнулись с небольшими трудностями. Дело в том, что мы совершенно не представляем как [Topic], где находятся все ценные данные наших испытаний, теперь доставить домой.
			Satellite = Среди агентств сейчас проходит конкурс на вывод спутников на заданные орбиты. Мы нуждаемся в содействии.
			Station = Мы хотим принять участие в строительстве действительно большой космической станции, и [Topic] выглядит очень привлекательным кандидатом для этой затеи.
			Survey = Наш научный отдел уверен, что [Topic] таит в себе немало интересного. Мы хотим, чтобы кто-нибудь посетил <<O:2>> загадочные места и как следует осмотрелся.
			Survey = Некоторые кербалы утверждают, что [Topic] выглядит одинаково в любой точке. Мы категорически не согласны с этим и ищем желающих подтвердить наши доводы.
			Tourism = Мы хотим знать, готовы ли кербалы платить за лишние места, которые, мы уверены, есть на вашем корабле.
			Orbit = Мы считаем, что для выхода на орбиту вполне достаточно кербала с настолько сбитым прицелом, что при падении на поверхность он постоянно промахивался мимо неё.
			Orbit = Нам нужно знать, действительно ли невесомость - это так клёво!
			Kerbin = Мы не можем точно назвать длину дня на Кербине. Вроде бы она равна то ли 6, то ли 24 часам...
			Kerbin = Мы бы хотели доказать, что Кербин имеет форму идеального шара, а не сплюснутого эллипсоида, как утверждают некоторые мунатики.
			Mun = Мы хотим точно знать, насколько хорошей идеей является отправка на Муну.
			Mun = Нам нужно знать, насколько хорошо будут продаваться «Печеньки с Муны» (в какое потрясающее время мы с вами живём!).
			MunSrf = Мы пока не можем точно сказать, действительно ли поверхность Муны такая клёвая, как все думают.
			Minmus = Мы хотим точно знать, реален ли Минмус или это всего лишь вымысел.
			Minmus = Мы не можем точно сказать, насколько близок к нам Минмус.
			Minmus = Мы должны узнать, будет ли хорошо продаваться Мятное Мороженое Минмуса.
			MinmusSrf = Мы уверены, что прыжки по поверхности Минмуса доставляют непередаваемое удовольствие.
			MinmusSrf = Если поверхность Минмуса несъедобна, будут ли кербалы по-прежнему пытаться укусить её?
			Sun = Как высоко мы можем поднять что-то, прежде чем оно начнёт падать обратно?
			Sun = Мы подозреваем, что за пределами Кербина и его лун есть ещё много интересных мест, но опасаемся, что между ними слишком много пустого пространства.
			CometDetection = А потому нам хотелось бы, чтобы вы открыли несколько новых комет, вращающихся вокруг Солнца.
			CometDetection = Углубите свои знания о кометах, открыв несколько новых комет, обращающихся вокруг Солнца.
			RoverConstruction = Стыдно в этом признаваться, но у нас возник небольшой бардак с накладными. Оказалось, что в конструкции планетохода отсутствуют некоторые ключевые детали.
			RoverConstruction = Ввиду непредвиденных обстоятельств литоторможения некоторые детали оказались отделены от корпуса планетохода.
			RoverConstruction = Перед планетоходом была поставлена задача пройти значительное расстояние по поверхности тела, но ввиду недочётов конструкции он застрял на месте.
			VesselRepair = Мы не можем добраться до спутника и починить его, поэтому нам нужна ваша помощь.
			VesselRepair = Углубите свои знания о кометах, открыв несколько новых комет, обращающихся вокруг Солнца.
			OrbitConstruction = Наши инженеры рассчитали, что мы сможем извлечь из него больше пользы, если добавить одну-единственную деталь.
			OrbitConstruction = Срок службы спутника подходит к концу, но мы подсчитали, что всего одна деталь может продлить его и оправдать затраты на миссию.
		}
		Conclusion
		{
			Generic = Для этого нам понадобится ваша помощь.
			Generic = Готовы к новым свершениям на благо науки?
			Generic = Вы поможете нам в этом?
			Generic = Мы уверены, что вы сможете с этим разобраться.
			ARM = Ваша задача — доставить нам астероид. Будьте осторожны во время работы с захватом.
			CollectScience = Наша задача — приоткрыть завесы... происхождения кербалечества.
			CollectScience = Поэтому, если вы направите данные с этих спутников в нашу сторону, мы будем вам очень признательны.
			Exploration = Ну что, приступим?
			Exploration = Пришло ваше время внести свой вклад в прогресс всего кербалечества.
			CometSample = Доберитесь до кометы и вернитесь — или хотя бы передайте взятый с поверхности образец для сбора научных данных.
			ISRU = Итак, когда мы можем ждать первую поставку?
			PartTest = Мы предоставим вам список манипуляций, которые нужно произвести с данной деталью. Готовы взяться за это?
			PartTest = Помогите нам испытать эту деталь. Разумеется, не бесплатно.
			PlantFlag = Готовы установить флаг на соседней планете во имя кербалечества?
			RecoverAsset = Мы будем весьма признательны, если вы возьмётесь за выполнение этой операции по возвращению.
			Tourism = Сможете ли вы захватить в следующий полёт парочку дополнительных пассажиров?
			CometDetection = Используйте орбитальный телескоп, чтобы обнаружить уникальную сигнатуру новой кометы.
			RoverConstruction = Поэтому нам нужна ваша помощь. Почините планетоход на месте, установите недостающие детали и доведите его до места назначения, чтобы выполнить миссию.
			RoverConstruction = Возьмите в полёт инженера, чтобы тот отремонтировал планетоход, после чего совершите пробную поездку до указанных координат и удостоверьтесь, что всё работает.
			VesselRepair = Почините сломанную деталь, чтобы работа могла продолжаться.
			VesselRepair = Проведите ремонт сломанной детали, чтобы спутник продолжил функционировать в штатном режиме.
			OrbitConstruction = Прикрепите необходимую деталь, чтобы не заменять уже имеющуюся.
			OrbitConstruction = Отправьте на задание вашего отважного инженера, и этот спутник прослужит нам ещё много лет.
		}
	}
}
