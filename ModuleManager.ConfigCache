UrlConfig
{
	parentUrl = Squad/Parts/Utility/GrapplingDevice/part.cfg
	PART
	{
		name = GrapplingDevice
		module = Part
		author = Andrew Cassidy
		scale = 1
		node_attach = 0.0, 0.0, 0.00, 0.0, -1.0, 0.0, 1
		TechRequired = actuators
		entryCost = 5200
		cost = 450
		category = Coupling
		subcategory = 0
		title = Модуль захвата «Клешня»
		manufacturer = ООО «Кербал Движ»
		description = Инженеры часто сталкивались с проблемой, как извлечь из сложной техники упавшие инструменты. Озарение к нашей команде пришло после наблюдений за стажёром, вытряхивавшим камень из ботинка. Почему бы не перевернуть ракету вверх ногами и не потрясти её? Выдвижной захват неплохо справился с этой задачей, осилив даже подъём тяжелой техники. С тех пор для него нашлось множество других применений, помимо деликатных операций по извлечению инструментов. Также известен как «Клешня».
		attachRules = 1,1,0,0,0
		mass = 0.075
		dragModelType = default
		maximum_drag = 0.3
		minimum_drag = 0.2
		angularDrag = 1
		maxTemp = 2000
		fuelCrossFeed = False
		crashTolerance = 50
		breakingForce = 50
		breakingTorque = 50
		bulkheadProfiles = size1, srf
		tags = a.r.m arm asteroid capture clam claw connect dock fasten grab join klaw nasa рука астероид захват зажим клешня соединение стыковка крепление хват наса
		rescaleFactor = 1
		node_stack_top = 0.0, -0.14082675, 0.00, 0.0, -1.0, 0.0, 1
