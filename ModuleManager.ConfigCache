		title = Ионный двигатель IX-6315 «Заря»
		manufacturer = Ионик Синхрофазотроника
		description = Испуская поток ионизированного ксенона через небольшое управляемое сопло, IX-6315 «Заря» обладает невероятно высоким удельным импульсом. Недостатком является очень низкая тяга и высокое энергопотребление. Согласно официальным заявлениям представителей «Ионик Синхрофазотроника», слухи о том, что данный двигатель работает на «чёрной магии», крайне преувеличены.
		attachRules = 1,0,1,1,0
		mass = 0.25
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.2
