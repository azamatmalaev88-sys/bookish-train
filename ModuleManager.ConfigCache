UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Integrated Integrals
		title = Интеграл Интегрейтед
		description = Недостаток опыта эта небольшая компания с лихвой компенсирует амбициозностью реализуемых проектов. Первым её детищем стала тяжёлая мобильная исследовательская лаборатория. По слухам, она изначально проектировалась как секретный мобильный перерабатывающий завод для изготовления экспериментальной полулегальной топливной смеси, которой приписывали лучшие по сравнению с аналогами характеристики и незабываемый синий оттенок. Тем не менее, эти слухи так и не нашли официального подтверждения, а таинственное топливо до сих пор не видел ни один кербал, которого можно было бы отнести к надежным источникам. Несмотря на постоянные попытки опровергнуть эти сплетни, компания по-прежнему не может избавиться от дурной (возможно, не вполне заслуженной) репутации. Пытаясь улучшить свой образ, компания предлагает вкладчикам крупные дивиденды, что, впрочем, никак на её имидже не сказывается.
		logoURL = Squad/Agencies/IntegratedIntegrals
		logoScaledURL = Squad/Agencies/IntegratedIntegrals_scaled
		mentality = Commercial
		mentality = Scientific
		mentality = Conglomerate 0.1
		mentality = Moral 0.2
		mentality = Perfectionist
	}
}
