UrlConfig
{
	parentUrl = Squad/Parts/Command/advancedSasModuleLarge/advSasModuleLarge.cfg
	PART
	{
		name = asasmodule1-2
		module = Part
		author = Chris Adderley (Nertea)
		iconCenter = 0, 3, 0
		node_stack_top = 0, 0.25, 0, 0.0, 1.0, 0.0, 2
		node_stack_bottom = 0, -0.25, 0, 0.0, -1.0, 0.0, 2
		buoyancy = 0.1
		buoyancyUseSine = False
		TechRequired = specializedControl
		entryCost = 11600
		cost = 2100
		category = Control
		subcategory = 0
		title = Большой улучшенный гиродин
		manufacturer = БАЛАНС Инжиниринг
		description = После долгих лет исследований инженеры «БАЛАНС Инжиниринг» обнаружили, что для управления большими кораблями требуется больше мощности. Большой улучшенный гиродин предназначен для решения этой проблемы с помощью запатентованных Больших маховиков™, обеспечивающих «Большой крутящий момент» (патент на рассмотрении). «БАЛАНС Инжиниринг» быстро отклонили всю критику касательно необходимости настолько объёмной научной работы, заявив, что «это только теперь кажется простым, когда мы уже всё сделали». Критики по-прежнему настроены скептически, но никто не может не согласиться, что этот гиродин действительно обеспечивает намного больший момент, чем предыдущие модели. Также он требует намного больше энергии, и инженеры «БАЛАНС Инжиниринг» в данное время ведут интенсивную исследовательскую работу, чтобы понять, почему это так.
		attachRules = 1,0,1,1,0
		mass = 0.2
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.2
		angularDrag = 2
		crashTolerance = 9
		maxTemp = 2000
		bulkheadProfiles = size2
		tags = cmg command control fly gyro moment react stab steer torque управляющий гироскоп управлением полёт гиро момент (реакт стабилизатор руль усилие
		rescaleFactor = 1
		MODULE
		{
			name = ModuleReactionWheel
			PitchTorque = 30
			YawTorque = 30
			RollTorque = 30
			torqueResponseSpeed = 30
			RESOURCE
			{
				name = ElectricCharge
				rate = 0.6
			}
		}
		MODULE
		{
			name = ModuleCargoPart
			packedVolume = -1
		}
		MODEL
		{
			model = ReStock/Assets/Control/restock-reactionwheel-25-1
		}
		DRAG_CUBE
		{
			cube = Default, 1.245,0.7807,1.345, 1.245,0.7807,1.345, 4.643,0.9184,0.5737, 4.643,0.959,0.5463, 1.245,0.7746,1.345, 1.245,0.7746,1.345, 0,0,0, 2.5,0.5,2.5
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Parts/Command/cupola/cupola.cfg
	PART
	{
		name = cupola
		module = Part
		author = Chris Adderley (Nertea)
		rescaleFactor = 1.0
		node_stack_bottom = 0.0, -0.4, 0.0, 0.0, -1.0, 0.0, 2
		node_stack_top = 0.0, 0.83, 0.0, 0.0, 1.0, 0.0, 1
		TechRequired = commandModules
		entryCost = 10200
		cost = 1600
		category = Pods
		subcategory = 0
		title = Модуль PPD-12 «Купол»
		manufacturer = «СвалКО» Джеба Кермана
		description = PPD-12 был разработан, чтобы обеспечить орбитальные станции кабиной с хорошим обзором и местом, где кербонавты могут погрузиться в размышления о бескрайних просторах и невиданной красоте космоса.
		attachRules = 1,0,1,1,0
		mass = 0.94
		dragModelType = default
		maximum_drag = 0.20
		minimum_drag = 0.20
		angularDrag = 4
		crashTolerance = 8
		maxTemp = 1000
		skinMaxTemp = 2000
		vesselType = Lander
		CrewCapacity = 1
		bulkheadProfiles = size2, size1
		tags = base capsule cmg command control ?eva fly gyro ?iva moment outpost pilot pod react rocket space stab statio steer torque view основание капсула управляющий гироскоп управление полёт гиро момент внешний модуль пилот (реакт ракета космос стабилизатор станция руль усилие обзор
		INTERNAL
		{
			name = cupolaInternal
		}
		MODULE
		{
			name = ModuleCommand
			minimumCrew = 1
			defaultControlPointDisplayName = Вверх
			CONTROLPOINT
			{
				name = forward
				displayName = Вперед
				orientation = 90,0,0
			}
			CONTROLPOINT
			{
				name = reverse
				displayName = Инвертированное
				orientation = 0,0,180
			}
		}
		RESOURCE
		{
			name = ElectricCharge
			amount = 200
			maxAmount = 200
		}
		MODULE
		{
			name = ModuleReactionWheel
			PitchTorque = 9
			YawTorque = 9
			RollTorque = 9
			RESOURCE
			{
				name = ElectricCharge
				rate = 0.9
			}
		}
		MODULE
		{
			name = ModuleScienceExperiment
			experimentID = crewReport
			experimentActionName = Доклад экипажа
			resetActionName = Отклонить доклад экипажа
			reviewActionName = Просмотреть отчёт
			useStaging = False
			useActionGroups = True
			hideUIwhenUnavailable = True
			rerunnable = True
			xmitDataScalar = 1.0
			usageReqMaskInternal = 5
			usageReqMaskExternal = -1
			interactionRange = 2
		}
		MODULE
		{
			name = ModuleScienceContainer
			reviewActionName = Просмотреть данные
			storeActionName = Сохранить данные
			evaOnlyStorage = True
			storageRange = 2
		}
		RESOURCE
		{
			name = MonoPropellant
			amount = 10
			maxAmount = 10
		}
		MODULE
		{
			name = FlagDecal
			textureQuadName = flagTransform
		}
		MODULE
		{
			name = ModuleColorChanger
			shaderProperty = _EmissiveColor
			animRate = 0.8
			animState = false
			useRate = true
			toggleInEditor = true
			toggleInFlight = true
			toggleInFlight = true
			unfocusedRange = 5
			toggleName = Перекл. освещение
			eventOnName = Вкл. свет
			eventOffName = Выкл. свет
			toggleAction = True
			defaultActionGroup = Light
			redCurve
			{
				key = 0 0 0 3
				key = 1 1 0 0
			}
			greenCurve
			{
				key = 0 0 0 1
				key = 1 1 1 0
			}
			blueCurve
			{
				key = 0 0 0 0
				key = 1 0.7 1.5 0
			}
			alphaCurve
			{
				key = 0 1
			}
		}
		MODULE
		{
			name = ModuleDataTransmitter
			antennaType = INTERNAL
			packetInterval = 1.0
			packetSize = 2
			packetResourceCost = 12.0
			requiredResource = ElectricCharge
			antennaPower = 5000
			optimumRange = 2500
			packetFloor = .1
			packetCeiling = 5
		}
		MODULE
		{
			name = ModuleCargoPart
			stackableQuantity = 1
			packedVolume = -1
		}
		MODEL
		{
			model = ReStock/Assets/Command/restock-cupola-1
			position = 0.0, 0.0, 0.0
			scale = 1,1,1
			rotation = 0, 0, 0
		}
		MODEL
		{
			model = ReStock/Assets/Command/restock-crewed-endcap-1
			position = 0.0, -0.4, 0.0
			scale = 1,-1,1
			rotation = 0, 0, 0
		}
	}
}
