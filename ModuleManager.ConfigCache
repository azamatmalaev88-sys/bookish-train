	}
}
UrlConfig
{
	parentUrl = Squad/Parts/Cargo/Parachute/Parachute.cfg
	PART
	{
		name = evaChute
		module = Part
		author = Squad
		rescaleFactor = 1
		TechRequired = start
		entryCost = 0
		cost = 10
		category = Cargo
		subcategory = 0
		title = Личный парашют
		manufacturer = Нашли на обочине
		description = Этот кербальский параплан надёжно застрахует бесстрашных пилотов от капризов непродуманных летательных аппаратов или безрассудных выходок с такими непредвиденными факторами, как крыша ЦВС и автопилот, который, может, работает, а может, и нет.\n\nСпрашивается, почему кербалы так доверяют найденным у обочины предметам? Да потому, что рядом нет кратера в форме кербала!
		attachRules = 0,0,0,0,0
		mass = 0.004
		dragModelType = default
		maximum_drag = 0.1
		minimum_drag = 0.1
		angularDrag = 2
		crashTolerance = 12
		maxTemp = 2000
		tags = остановка купол парашют замедление сопротивление падение посадка приземление безопасность медленно кербал груз космический
		MODEL
		{
			model = Squad/Parts/Cargo/Parachute/Parachute
		}
		MODULE
		{
			name = ModuleCargoPart
			packedVolume = 10
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Parts/Cargo/RepairKit/RepairKit.cfg
	PART
	{
		name = evaRepairKit
		module = Part
		author = Squad
		rescaleFactor = 1
		CoMOffset = 0, 0.085, 0
		CoLOffset = 0, 0.085, 0
		CoPOffset = 0, 0.085, 0
		TechRequired = spaceExploration
		entryCost = 1500
		cost = 75
		category = Cargo
		subcategory = 0
		title = Ремкомплект для открытого космоса
		manufacturer = ООО «Кербал Движ»
		description = В этом ремонтном наборе содержатся клейкая лента, инструменты и прочие штуковины, так необходимые отважным кербалам для ремонта не вовремя вышедших из строя деталей.\n\nПримечание: ремкомплекты тратятся при ремонте. Для ремонта особо крупных деталей может понадобиться несколько комплектов.
		attachRules = 0,0,0,0,0
		mass = 0.005
		dragModelType = default
		maximum_drag = 0.1
		minimum_drag = 0.1
		angularDrag = 2
		crashTolerance = 12
		maxTemp = 1200
		tags = починить (сломано ремонт
		MODEL
		{
			model = Squad/Parts/Cargo/RepairKit/RepairKit
		}
		EFFECTS
		{
			repair1
			{
				AUDIO
				{
					channel = Ship
					clip = Squad/Sounds/repairKit_repair1.wav
					maxVolumeDistance = 150
				}
			}
			repair2
			{
				AUDIO
				{
					channel = Ship
					clip = Squad/Sounds/repairKit_repair2.wav
					maxVolumeDistance = 150
				}
			}
		}
		MODULE
		{
			name = ModuleCargoPart
			stackableQuantity = 4
			packedVolume = 5
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Parts/Cargo/ScienceKit/evaScienceKit.cfg
	PART
	{
		name = evaScienceKit
		module = Part
		author = Squad
		rescaleFactor = 1
		CoMOffset = 0, 0.11, 0
		CoLOffset = 0, 0.11, 0
		CoPOffset = 0, 0.11, 0
		TechRequired = miniaturization
		entryCost = 1500
		cost = 150
		category = Cargo
		subcategory = 0
		title = Набор для экспериментов в открытом космосе
		manufacturer = Горизонд Инк.
		description = Корпорация «Горизонд» очень тщательно подошла к созданию этого набора различных приборов, необходимых для проведения научных экспериментов.\n\nНесмотря на все заверения в обратном, нам кажется, что наши астронавты так и не смогли найти достойное применение шапокляку и волшебной палочке исключительно ввиду нехватки творческого мышления… а не потому, что они достались нам в состоянии «б/у».
		attachRules = 0,0,0,0,0
		mass = 0.015
		dragModelType = default
		maximum_drag = 0.1
		minimum_drag = 0.1
		angularDrag = 2
		crashTolerance = 14
		maxTemp = 1200
		tags = открытый космос научный тест набор эксперимент пасхалка снаружи гольф груз
		MODEL
		{
			model = Squad/Parts/Cargo/ScienceKit/ExperimentKit
		}
		MODULE
		{
			name = ModuleCargoPart
			stackableQuantity = 4
			packedVolume = 5
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Parts/Cargo/StorageUnits/CargoStorageUnit.cfg
	PART
	{
		name = CargoStorageUnit
		module = Part
		author = Kavaeric
		rescaleFactor = 1
		node_stack_top = 0.0, 0.3125, 0.0, 0.0, 1.0, 0.0, 2
		node_stack_bottom = 0.0, -0.3125, 0.0, 0.0, -1.0, 0.0, 2
		TechRequired = advExploration
		entryCost = 3500
		cost = 1500
		category = Cargo
		subcategory = 0
		title = Грузовой контейнер «СЕК-24»
		manufacturer = НПО «Эксперимент»
		description = Если хотите взять в полёт всё сразу и ещё немножко сверху, то этот контейнер точно вам понравится.\n\nВ него можно поместить 24 грузовые детали или столько мелочей и мебели, что хватит на целый домик. Колонизировать Дюну надо красиво!
		attachRules = 1,0,1,1,0
		mass = 0.4
		dragModelType = default
		crashTolerance = 14
		bulkheadProfiles = size2
		maxTemp = 1200
		tags = хранить хранилище груз детали
		MODULE
		{
			name = ModuleCargoPart
			packedVolume = -1
		}
		MODULE
		{
			name = ModuleInventoryPart
			InventorySlots = 24
			packedVolumeLimit = 2500
		}
		MODEL
		{
			model = ReStock/Assets/Payload/restock-cargo-inventory-25-1
		}
		MODULE
		{
			name = ModulePartVariants
			baseVariant = white
			VARIANT
			{
				name = white
				displayName = Белый
				primaryColor = #ffffff
				secondaryColor = #ffffff
				GAMEOBJECTS
				{
					restock-cargo-inventory-25-white = true
					restock-cargo-inventory-25-metal = false
				}
			}
			VARIANT
			{
				name = metal
				displayName = Металлик
				primaryColor = #6f6e6d
				secondaryColor = #6f6e6d
				GAMEOBJECTS
				{
					restock-cargo-inventory-25-white = false
					restock-cargo-inventory-25-metal = true
				}
			}
		}
	}
}
