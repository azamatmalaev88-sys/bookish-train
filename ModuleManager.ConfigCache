		description = Пытаясь устранить ряд конструкторских недостатков топливной линии FTX-1, один из инженеров в лабораториях FLOOYD Dynamics предложил смелое решение: а что если вообще не подсоединять топливный шланг к резервуару? Тогда не нужно заботиться о том, чтобы топливо подавалось в нужном направлении — оно просто будет выливаться на землю! Вследствие этого инженера понизили и перевели работать в бухгалтерию, но чуть позже сотрудники лаборатории FLOOYD воплотили его идею в жизнь в виде FTE-1 — клапана, который позволяет сливать содержимое компонентов, на которые он установлен. Самое то для аварийных ситуаций, регулировки плавучести или веселых шуток с ракетами.
		attachRules = 0,1,0,0,0
		mass = 0.01
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.2
		angularDrag = 1
		crashTolerance = 12
		maxTemp = 2000
		PhysicsSignificance = 1
		bulkheadProfiles = srf
		tags = слив убрать лтм лт руда ксенон (топливный бак монотопливо
		MODULE
		{
			name = ModuleResourceDrain
			fullResourceDrainTime = 10
			drainUnloaded = true
		}
		MODULE
		{
			name = ModuleCargoPart
			stackableQuantity = 4
			packedVolume = 2
		}
		MODEL
		{
			model = ReStock/Assets/Resource/restock-fuel-vent-1
		}
		MODULE
		{
			name = ModulePartVariants
			useMultipleDragCubes = false
			baseVariant = Metal
			VARIANT
			{
				name = Metal
				displayName = Металлик
				themeName = Metal
				primaryColor = #6f6e6d
				secondaryColor = #6f6e6d
				GAMEOBJECTS
				{
					Vent_metal = true
					Vent_striped = false
				}
			}
			VARIANT
			{
				name = Striped
				displayName = Сигнальные полосы
				themeName = Gray with Stripes
				primaryColor = #4c4f47
				secondaryColor = #A4823F
				GAMEOBJECTS
