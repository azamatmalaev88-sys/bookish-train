		sound_vent_large = deploy
		TechRequired = specializedConstruction
		entryCost = 6100
		cost = 600
		category = Payload
		subcategory = 0
		title = Защитный обтекатель AE-FF2 (2,5 м)
		manufacturer = Научная лаборатория НИТРО2
		description = Пока в Центре управления полётами придумывали способы возвращения корабля с орбиты в целости и сохранности, инженеры-исследователи НИТРО2 вовремя осознали, что защита деталей во время взлёта не менее важна. В надежде создать эффективный защитный обтекатель для полезной нагрузки и межступенчатых элементов было профинансировано сложнейшее исследование двухмерного процедурного строительства. Мы также надеемся, что улучшение аэродинамики позволит сэкономить немного драгоценного топлива!
		attachRules = 1,0,1,1,0
		mass = 0.175
		thermalMassModifier = 2.0
		skinMassPerArea = 4.0
		skinInternalConductionMult = 0.25
		emissiveConstant = 0.8
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.2
		angularDrag = 2
		crashTolerance = 9
		maxTemp = 2600
		fuelCrossFeed = True
