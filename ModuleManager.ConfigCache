			#autoLOC_501238 = Орбита Один
			#autoLOC_501239 = Неизвестно, чем руководствовались инженеры при выборе названия для этого аппарата, порядковым номером в серии или количеством ускорителей. Наши пилоты считают его как минимум «недоработанным». Как бы то ни было, это очень интересный экземпляр.
			#autoLOC_501240 = Мунолёт серии PT
			#autoLOC_501241 = Мунолёт серии PT. Минималистичная ракета-носитель со спускаемым аппаратом суперэкономкласса для полётов на Муну и Минмус.\n\nБатареи, стабилизаторы и научное оборудование продаются отдельно.
			#autoLOC_501242 = Вездеход со спусковым модулем
			#autoLOC_501243 = Один из самых амбициозных проектов среди представленных в каталоге «Картонажа», особенно если всерьёз задумываться о его применении на других планетах. \n\nДля доставки в космос (и далее) требуется отдельный носитель, однако четырёх ракетных двигателей спускового модуля вполне хватит, чтобы вволю покуражиться во время испытаний на стартовом столе.\n\nЦитата из руководства по эксплуатации: «при приближении к поверхности снизьте скорость и постарайтесь не разбить вездеход во время посадки».
			#autoLOC_501244 = Маленький Учёный
			#autoLOC_501245 = Экспериментальный комплект для начинающих, включающий в себя защитные очки, шпатель и ракету-носитель.\n\nДля детей от 3 лет.
			#autoLOC_501246 = Челнок «Стройный»
