		manufacturer = Реактив Системс Лтд.
		description = Космический реактивный ранец верой и правдой служит кербальским астронавтам уже на протяжении многих десятилетий. Он оказался настолько полезным, что некоторые кербалы не снимают его в помещениях, дома и даже в душе.\n\nРеактивный ранец позволяет перемещаться в условиях низкой гравитации и невесомости, но освоить его очень непросто. Введение программы обучения использованию реактивного ранца снизило количество сопутствующих травм почти на 10%.
		attachRules = 0,0,0,0,0
		mass = 0.02
		dragModelType = default
		maximum_drag = 0.1
		minimum_drag = 0.1
		angularDrag = 2
		crashTolerance = 12
		maxTemp = 2000
		resourcePriorityOffset = 2
		tags = ранец тяга реактивный РСУ кербал управление груз космический
		MODEL
		{
			model = Squad/Parts/Cargo/Jetpack/Jetpack
		}
		MODULE
		{
			name = ModuleCargoPart
			packedVolume = 17
			reinitResourcesOnStoreInVessel = true
		}
		RESOURCE
		{
			name = EVA Propellant
			amount = 5
			maxAmount = 5
			isTweakable = False
