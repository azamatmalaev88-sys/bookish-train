UrlConfig
{
	parentUrl = Squad/Parts/Cargo/CargoContainers/cargoContainer.cfg
	PART
	{
		name = cargoContainer
		module = Part
		author = Kavaeric
		rescaleFactor = 1
		node_stack_top = 0.0, 0.3, 0.0, 0.0, 1.0, 0.0, 1
		node_stack_bottom = 0.0, -0.3, 0.0, 0.0, -1.0, 0.0, 1
		TechRequired = advExploration
		entryCost = 2200
		cost = 600
		category = Cargo
		subcategory = 0
		title = Модуль хранения «СЕК-9»
		manufacturer = НПО «Эксперимент»
		description = Вместительный контейнер (1,25 м) для хранения разнообразного оборудования. Разработан для хранения точных научных инструментов и их защиты от любых повреждений при жёстких запусках, полётах и посадках на отдалённые планеты.\n\nВнимание: содержимое не подвергается герметизации. Риск взрыва пакетов с чипсами: свыше 99%.
		attachRules = 1,0,1,1,0
		mass = 0.15
		dragModelType = default
		maximum_drag = 0.2
		minimum_drag = 0.3
		angularDrag = 2
		crashTolerance = 14
		bulkheadProfiles = size1
		maxTemp = 1200
		heatConductivity = 0.04
		thermalMassModifier = 5.0
		emissiveConstant = 0.95
		tags = хранить хранилище груз поверхность
		MODULE
		{
			name = ModuleCargoPart
			packedVolume = -1
		}
		MODULE
		{
			name = ModuleInventoryPart
			InventorySlots = 9
			packedVolumeLimit = 650
		}
		MODEL
		{
			model = ReStock/Assets/Payload/restock-cargo-inventory-125-1
		}
		MODULE
		{
			name = ModulePartVariants
			baseVariant = white
			VARIANT
			{
				name = white
				displayName = Белый
				primaryColor = #ffffff
				secondaryColor = #ffffff
				GAMEOBJECTS
				{
					restock-cargo-inventory-12-1-white = true
					restock-cargo-inventory-12-1-metal = false
				}
			}
			VARIANT
			{
				name = metal
				displayName = Металлик
				primaryColor = #6f6e6d
				secondaryColor = #6f6e6d
				GAMEOBJECTS
				{
					restock-cargo-inventory-12-1-white = false
					restock-cargo-inventory-12-1-metal = true
				}
			}
		}
	}
}
