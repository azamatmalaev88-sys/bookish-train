		name = O.M.B. Demolition Enterprises
		title = Бомб Демонтаж Корп.
		description = Основой высокой деловой репутации «Бомб Демонтаж Корп.» является её уникальное умение разрушать всё, что только можно. Именно это позволило компании занять заметное положение на рынке аэрокосмических технологий со своей взрывоопасной продукцией. Там, где необходимо получить из одного космического корабля несколько меньших по размеру, высокоточным отделителям компании просто нет равных. Остальные разрушительные изделия компании, несмотря на активную рекламу и гораздо большую «разделительную» способность, особого успеха не имели. Руководство «Бомб Демонтаж» по-прежнему не понимает, почему эти «очевидно более мощные» предложения так и нашли своего покупателя.
		logoURL = Squad/Agencies/OMBDemolition
		logoScaledURL = Squad/Agencies/OMBDemolition_scaled
		standing = Rockomax Conglomerate, 0.6
		mentality = Commercial
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Periapsis Rocket Supplies Co
		title = Корпорация «Перицентр Комплект»
		description = «Космические припасы Перицентра» — это загадочная частная компания, чей ассортимент, пожалуй, излишне скудный, а те детали, которые она всё же выпускает, делают ее только загадочнее. Многие спрашивают, почему компания производит так мало, но в «Перицентре» всегда отвечают: «Сейчас-сейчас, скоро всё увидите!». Впрочем, этот ответ не менялся уже три поколения, так что это их «скоро» несколько затянулось.
		logoURL = Squad/Agencies/PeriapsisCo
		logoScaledURL = Squad/Agencies/PeriapsisCo_scaled
		mentality = Perfectionist
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Probodobodyne Inc
		title = Горизонд Инк.
		description = Когда-то «Горизонд Инк.» была одним из ведущих игроков на зарождающемся рынке аэрокосмических технологий. С годами компания утратила прежние позиции, однако она по-прежнему остается верна своей философии, предполагающей, что освоение космоса является уделом избранных смельчаков, способных принять его вызов с минимальной технической оснащенностью. Их продукция в полной мере отражает этот практичный и, вероятно, несколько устаревший подход, даже несмотря на то, что множество молодых фирм предлагают альтернативные решения, делающие космические путешествия намного доступнее, чем во времена первопроходцев. Тем не менее, фирма сохранила немногочисленное, но преданное сообщество поклонников хардкорных полётов, которые по-прежнему считают, что космос — это место только для самых лучших кербонавтов и инженеров.
		logoURL = Squad/Agencies/Probodobodyne
		logoScaledURL = Squad/Agencies/Probodobodyne_scaled
		mentality = Pioneer
		mentality = Perfectionist
		mentality = Stern 0.8
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Research & Development Department
		title = Научно-исследовательский отдел
		description = Это собственный научно-исследовательский отдел космической программы, возглавляемый знаменитым учёным и конструктором Вернером фон Керманом. Эти парни — мозг всей космической программы, ими движет неутолимая жажда знаний, любая информация для них важна и заслуживает внимания, а своей единственной целью они видят обогащение Кербина новыми знаниями. Главная мечта наших гениев — это должное признание их вклада в развитие современной науки, а также чтобы кербонавты, НАКОНЕЦ, научились отряхивать обувь, прежде чем войти в лабораторию.
		logoURL = Squad/Agencies/R&D
		logoScaledURL = Squad/Agencies/R&D_scaled
		mentality = Scientific
		mentality = Pioneer
		mentality = Kerbalminded 0.2
	}
}
UrlConfig
{
	parentUrl = Squad/Agencies/Agents.cfg
	AGENT
	{
		name = Reaction Systems Ltd
		title = ОАО «Реактивные Системы»
		description = ОАО «Реактивные Системы» — это небольшая фирма, успех которой принёс один единственный удачный продукт — линейный двигатель РСУ «Кудапопало». Сегодня никто точно не знает, над чем ещё они работают. «Реактивные Системы» не самая крупная из представленных на рынке компаний, однако при этом они никогда не отказываются поддержать инновационные начинания. Кроме того, агрессивная политика компании в отношении заключения научных контрактов породила целую волну слухов о том, что они готовятся выпустить что-то поистине уникальное.
		logoURL = Squad/Agencies/ReactionSystemsLtd
		logoScaledURL = Squad/Agencies/ReactionSystemsLtd_scaled
		mentality = Commercial
