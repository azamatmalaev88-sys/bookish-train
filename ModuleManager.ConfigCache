			#autoLOC_8005248 = Посадить «Валсход-2» на воду
			#autoLOC_8005249 = Первый пошёл
			#autoLOC_8005250 = Очередное удачное приземление!\n\nОсталось посадить спутник, чтобы вернуть остальную часть экипажа на землю.
			#autoLOC_8005251 = Очередное удачное приземление!\n\nОсталось посадить «Валсход», чтобы вернуть остальную часть экипажа на землю.
			#autoLOC_8005252 = О нет!
			#autoLOC_8005253 = Из-за сбоя ваши электрические системы начали выходить из строя.\n\n<b>Торопитесь!</b>
			#autoLOC_8005254 = «Валсход-2» терпит крушение
			#autoLOC_8005255 = Позволяет проверить, потерпел ли крушение «Валсход-2».
			#autoLOC_8005256 = Ваша цель — вернуться домой целыми и невредимыми, а не устроить в небе (бесспорно, невообразимо зрелищный) гигантский взрыв!
			#autoLOC_8005257 = SWM-94 терпит крушение
			#autoLOC_8005258 = Позволяет проверить, потерпел ли крушение SWM-94.
			#autoLOC_8005259 = Этот спутник был вашим билетом домой.\n\nВ следующий раз постарайтесь его не взрывать!
			#autoLOC_8005260 = Включить бортовую камеру
			#autoLOC_8005261 = Изменить настройки камеры игрока или заблокировать её
			#autoLOC_8005262 = Повреждение электрооборудования: отказ двигателей
			#autoLOC_8005263 = Переход на SWM-94
			#autoLOC_8005264 = Подготовиться к перезагрузке
			#autoLOC_8005265 = Подготовиться к отправке сообщения
			#autoLOC_8005266 = Отлично! У вас получилось. <b><i>Передача данных проверки экипажа</b></i> запустит перезагрузку.
			#autoLOC_8005267 = Посадить «Валсход-2»
			#autoLOC_8005268 = Мы потеряли «Валсход-2»
			#autoLOC_8005269 = К сожалению, вы опоздали.\n\nМы потеряли аппарат и его экипаж.
			#autoLOC_8005270 = Провал миссии
			#autoLOC_8005271 = Взорвать «Валсход-2»
			#autoLOC_8005272 = Ожидание взрыва
			#autoLOC_8005273 = Джеб переходит на SWM-94
			#autoLOC_8005274 = Привет, Джеб!
			#autoLOC_8005275 = Привет, Джеб... Хм, речь же изначально шла о Томфорде.\n\nОтправьте его сюда, скорее!
			#autoLOC_8005276 = «Наполлон-15»
			#autoLOC_8005277 = Приветствую, коллеги! Наконец пришло время приступить к изучению второго естественного спутника нашей планеты. По большей части мы будем бороздить его просторы и собирать камни, поэтому среди прочего нам потребуется мощный планетоход. Давайте <b><i>построим корабль, который сможет утащить планетоход на Минмус и вывезти ценный груз на Кербин</b></i>.
			#autoLOC_8005278 = Построить планетоход и корабль для его доставки
			#autoLOC_8005279 = Планетоход для Минмуса, который способен добыть и перевезти небольшое количество руды (<50).
			#autoLOC_8005280 = Совершить посадку на Минмус
			#autoLOC_8005281 = Добраться до места добычи
			#autoLOC_8005282 = Добыть руду
			#autoLOC_8005283 = Миссия 7: диалог 3
			#autoLOC_8005284 = «Наполлон-15»
			#autoLOC_8005285 = «Наполлон-15», для вас есть неожиданное задание! \n\nВ это трудно поверить, но мы получили сигнал бедствия от потерянного на Минмусе кербонавта. \n\nМы почти уверены, что это ложная тревога, потому что до вас мы туда никого не отправляли. Но вы <b><i>скатайтесь в этот район</b></i> и посмотрите, в чем дело. Мало ли что.
			#autoLOC_8005286 = Разместить Валентину
			#autoLOC_8005287 = Отправиться к Валентине
			#autoLOC_8005288 = Миссия 7: диалог 4
			#autoLOC_8005289 = Спасение Валентины
			#autoLOC_8005290 = «Наполлон-15», говорит Уолт. \n\nВыходит, потерянным кербонавтом была Валентина Керман? Странно, она же уходила в отпуск на две недели...\n\nГм-м, а вообще я вдруг вспомнил, что в ЦВС на днях недосчитались нескольких деталей. Поверить не могу! \n\nС нетерпением ждём вашего возвращения на Кербин. <b><i>Отменяйте всё и возвращайтесь домой.</b></i>
			#autoLOC_8005291 = Миссия 7: диалог 5
			#autoLOC_8005292 = Доставка камней
			#autoLOC_8005293 = Отличная работа, «Наполлон 15»! \n\nПора вам с вашими загадочными камнями и спасённой кербонавткой <b><i>лететь домой</b></i>. \n\nУже предвкушаю, как сделаю из вашей добычи рагу с грибами! \n\nИз камней, конечно, а не из кербонавтки. \n\nПросто доберитесь целыми и невредимыми, ага? Мы задали вам удобную цель: <b><i>постарайтесь приземлиться в указанной точке</b></i>.
			#autoLOC_8005294 = Совершить посадку в указанной области
			#autoLOC_8005295 = Поздравляем с успешным выполнением очередной миссии! Валентина спасена, а камни с Минмуса оценит по достоинству всё население Кербина. Кстати, они гораздо вкуснее в супе из водорослей, чем в рагу, но… кому какое дело?
			#autoLOC_8005296 = Миссия 7: диалог 1
			#autoLOC_8005297 = На Минмус
			#autoLOC_8005298 = Приветствую! Говорит Вернер фон Керман. \n\n «Наполлон-15» выглядит потрясающе! Уже скоро этот красавец привезёт нам чудесные камушки. Наши эксперты считают, что они добавят особой пикантности грибному рагу. Наша космическая программа здорово заработает на этом деликатесе. \n\n Первым делом <b><i>посадите аппарат на Минмусе в указанной области.</b></i>\n\n А, и кстати, не забудьте взять на борт инженера. После посадки планетоходу может потребоваться ремонт.
			#autoLOC_8005299 = Миссия 7: диалог 2
			#autoLOC_8005300 = Добыча камушков
			#autoLOC_8005301 = Отличная работа, «Наполлон-15»! \n\nНаши зонды обнаружили в этом регионе три месторождения вкуснейших камней. <b><i>Найдите эти месторождения, отправьте туда планетоход и утащите хотя бы по 1,5 единицы из каждого. А если решите играть по-крупному, то помните, что всего вы сможете увезти 60 единиц.</b></i> \nПора начинать добычу! Во имя науки… и гастрономии.
			#autoLOC_8005302 = Точная посадка на Минмус
			#autoLOC_8005303 = Спасти Валентину
			#autoLOC_8005304 = Посадка в указанной области
			#autoLOC_8005305 = Выход к месту добычи
			#autoLOC_8005306 = «Наполлон-15» совершает посадку на воду
			#autoLOC_8005307 = «Наполлон-15» совершает посадку на воду!
			#autoLOC_8005308 = «Наполлон-15» терпит крушение!
			#autoLOC_8005309 = Время истекло
			#autoLOC_8005310 = Вы делали всё слишком медленно!
