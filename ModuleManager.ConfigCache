UrlConfig
{
	parentUrl = ReStrategia/Strategies/UncrewedMissions-1-KerbinProbes.cfg
	STRATEGY_BODY_EXPAND
	{
		author = fwdixon
		name = KerbinProgram
		id = KerbinProgram
