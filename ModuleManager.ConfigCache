			#autoLOC_308007 = Отделение ускорителей
			#autoLOC_308014 = Пора избавиться от опустевших ускорителей.\n\nНажмите <color=<<1>>>[<<2>>]</color>!
			#autoLOC_308030 = Сброс твердотопливных ускорителей
			#autoLOC_308041 = Вы отлично справляетесь. Продолжайте следить за индикатором цели и будьте готовы к отделению нижней ступени.
			#autoLOC_308057 = Отделение нижней ступени
