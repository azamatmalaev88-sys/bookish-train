UrlConfig
{
	parentUrl = Squad/Parts/Engine/Size3AdvancedEngine/part.cfg
	PART
	{
		name = Size3AdvancedEngine
		module = Part
		author = Chris Adderley (Nertea)
		node_stack_top = 0.0, 1.487975, 0.0, 0.0, 1.0, 0.0, 3
		node_stack_bottom = 0.0, -2.536873, 0.0, 0.0, -1.0, 0.0, 3
		TechRequired = veryHeavyRocketry
		entryCost = 68000
		cost = 25000
		category = Engine
		subcategory = 0
		title = ЖРД Кербодайн KR-2L+ «Носорог»
		manufacturer = Корпорация «Кербодайн»
		description = Появился в результате первой попытки корпорации «Кербодайн» построить высокотехнологичный двигатель. Инженеры так и не смогли вывести его на расчётную мощность в нижних слоях атмосферы без взрыва, поэтому он был представлен в качестве двигателя промежуточных ступеней. Опыт, полученный при создании этого двигателя, был использован для разработки следующих моделей, имеющих несколько камер сгорания с повышенным давлением (при этом не взрывающихся). Двигатель оптимизирован для работы на большой высоте и в космосе. Тем не менее, он может выдать вполне приличную тягу и на уровне моря.
		attachRules = 1,1,1,0,0
		mass = 9.0
