		requireNoAtmosphere = False
		situationMask = 63
		biomeMask = 7
		RESULTS
		{
			default = Огромная гравитация Джул захватила этого звёздного странника и направила на периодическую орбиту; в результате это космическое тело время от времени входит во внутреннюю систему. Данный образец позволяет нашим учёным установить, из чего состоял протопланетарный диск за орбитой Джула. Будьте с ним осторожны: он подтаивает.
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Resources/ScienceDefs.cfg
	EXPERIMENT_DEFINITION
	{
		id = cometSample_long
		title = Образец кометы, длинный период
		baseValue = 270
		scienceCap = 300
		dataScale = 1
		requireAtmosphere = False
		requireNoAtmosphere = False
		situationMask = 63
		biomeMask = 7
		RESULTS
		{
			default = По составу этой кометы можно изучить данные о состоянии молодой солнечной системы: небесное тело долго путешествовало в космосе и редко приближалось к солнцу. Микроскопическая пыль, содержащаяся в бережно упакованном вами образце, содержит поистине бесценную информацию для наших астрогеологов.
		}
	}
}
UrlConfig
{
	parentUrl = Squad/Resources/ScienceDefs.cfg
	EXPERIMENT_DEFINITION
	{
		id = cometSample_interstellar
		title = Образец кометы, межзвёздный
		baseValue = 900
		scienceCap = 1000
		dataScale = 1
		requireAtmosphere = False
		requireNoAtmosphere = False
		situationMask = 63
		biomeMask = 7
		RESULTS
		{
			default = Вы сумели забрать образец редчайшего космического материала — фрагмент вещества из-за пределов солнечной системы. Этот космический странник путешествует меж звёзд, крайне редко попадая в солнечный гравитационный колодец. Конечно, телескопы позволяют изучать галактику вдоль и поперёк, но получить фрагмент, проделавший столь долгий путь, — событие невероятное.
		}
	}
}
