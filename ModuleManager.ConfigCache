			resettableOnEVA = False
			hideFxModuleUI = True
			resourceToReset = Supplies
			resourceResetCost = 5
			xmitDataScalar = 0.25
			dataIsCollectable = True
			deployableSeated = False
		}
		MODULE
		{
			name = ModuleScienceExperiment
			experimentID = evaReport
			experimentActionName = Доложить об обстановке
			resetActionName = Отклонить доклад
			reviewActionName = Просмотреть отчёт
			hideUIwhenUnavailable = True
			rerunnable = True
			resettable = True
			resettableOnEVA = False
			hideFxModuleUI = True
			resourceToReset = Supplies
			resourceResetCost = 5
			xmitDataScalar = 1
			dataIsCollectable = True
		}
		MODULE
		{
			name = ModuleScienceExperiment
			experimentID = evaScience
			experimentActionName = Провести эксперимент в открытом космосе
			resetActionName = Удалить отчёт об эксперименте в космосе
			reviewActionName = Просмотреть отчёт об эксперименте в космосе
			hideUIwhenUnavailable = True
			rerunnable = True
			resettable = True
			resettableOnEVA = False
			hideFxModuleUI = True
			resourceToReset = Supplies
			resourceResetCost = 5
			xmitDataScalar = 1
			dataIsCollectable = True
			requiresInventoryPart = True
			requiresEVASituation = True
			deployableSeated = False
			availableShielded = False
			EVASITUATION
			{
				priority = 2
				situationMask = 1
				minTemp = 170
				kerbalAction = PlayGolf
				resultString = Проведены первые тесты на возможность заниматься спортом на других планетах. Новые аэродинамические качества мячей позволяют совершать впечатляющие удары, а цены на недвижимость до сих пор очень привлекательны.
				resultString = Мяч улетает по дуге далеко-далеко, и вы любуетесь, как приложенный импульс взаимодействует с силой притяжения. Учёных порадуют эти результаты…\n\n…но главное, чтобы они согласились, что выбор клюшки был исключительно правильным.
				resultString = Вы зарядили от души… то есть провели очень полезный научный эксперимент по применению плеча рычага к небольшому сферическому объекту.\n\nВидел бы вас Алан Керман!
			}
			EVASITUATION
			{
				situationMask = 1
				requiresNoAtmosphere = True
				maxTemp = 170
				kerbalAction = Banana
				resultString = Тщательное тестирование новых низкотемпературных закусочных технологий пошло не совсем по плану… и требует дальнейшего рассмотрения.
				resultString = Эксперименты с бананами в условиях низких температур прошли успешно, но для извлечения практической пользы нам всё ещё не хватает мини-шлюзов на скафандрах.
			}
			EVASITUATION
			{
				situationMask = 48
				requiresNoAtmosphere = True
				kerbalAction = Dzhanibekov
				dialogDelay = 4.5
				resultString = Раскручивание фланца в космосе привело к интересным и неожиданным результатам: он меняет ориентацию сам по себе без воздействия других сил.\n\nЕщё более удивителен тот факт, что наш космический аппарат работает в штатном режиме даже без этой детали.
				resultString = Наши учёные утверждают, что особенности колебания этого объекта в космосе вызваны наличием трёх различных моментов инерции на трёх различных осях и что в четырёхмерном пространстве такое было бы невозможно. Инженеры заявляют, что возможно, если дать им достаточное количество четырёхмерных ускорителей.
			}
		}
		MODULE
		{
			name = ModuleScienceContainer
			allowRepeatedSubjects = True
		}
		MODULE
		{
			name = FlagDecal
			textureQuadName = kbEVA_flagDecals
		}
		MODULE
		{
			name = FlagDecal
			textureQuadName = EVAStorage_flagDecals
		}
		MODULE
		{
			name = FlagDecal
			textureQuadName = EVAStorageSlim_flagDecals
		}
		MODULE
		{
			name = ModuleTripLogger
		}
		MODULE
		{
			name = ModuleEvaChute
			semiDeployedAnimation = semiDeploySmall
			fullyDeployedAnimation = fullyDeploySmall
			invertCanopy = true
			autoCutSpeed = 0.5
